<Project Sdk="Microsoft.NET.Sdk.Web">
  
  <PropertyGroup>
    <UserSecretsId>bfc66b1a-f4a8-421a-8bd2-2104aef1a6a0</UserSecretsId>
    <!-- S8970 is a false positive on Razor-generated code: SonarAnalyzer reports null-forgiving
         operators in @code blocks as if nullable warnings were disabled, even though this project
         has Nullable=enable. The diagnostic's syntax tree is a source-generator-produced file with no
         real path, so neither .editorconfig severity overrides nor #pragma suppression reach it -
         only a project-level NoWarn does. Only this project (and Neba.Website.Client, which has no
         @code blocks) contains .razor files, so this is effectively scoped to Razor already. -->
    <NoWarn>$(NoWarn);S8970</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Azure.Security.KeyVault" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" />
    <PackageReference Include="Blazor-ApexCharts" />
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="UnitsNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neba.Api.Contracts\Neba.Api.Contracts.csproj" />
    <ProjectReference Include="..\Neba.Website.Client\Neba.Website.Client.csproj" />
    <ProjectReference Include="..\Neba.ServiceDefaults\Neba.ServiceDefaults.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="Neba.Website.Tests" />
    <InternalsVisibleTo Include="Neba.TestFactory" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Exclude JavaScript test files from publish -->
  <ItemGroup>
    <Content Remove="**/*.tests.js" />
  </ItemGroup>

  <!-- Embed docs/help (ADR-0007 user help documentation) into the assembly so it ships with the app.
       Glob-based: adding a new docs/help/{name}.md or docs/help/images/{name}/{file}.png needs no csproj change. -->
  <ItemGroup>
    <EmbeddedResource Include="../../docs/help/*.md">
      <LogicalName>Help.Docs.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../docs/help/images/**/*.png">
      <LogicalName>Help.Images.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
