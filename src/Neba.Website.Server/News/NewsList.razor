@page "/news"
@using Neba.Api.Contracts
@using Neba.Api.Contracts.News
@using Neba.Api.Contracts.News.ListArticles
@using Neba.Api.Contracts.Security
@using Neba.Website.Server.Notifications
@using Neba.Website.Server.Services
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ApiExecutor ApiExecutor
@inject INewsApi NewsApi
@inject ILogger<NewsList> Logger
@inject ToastService ToastService

<PageTitle>News - BowlNEBA</PageTitle>
<HeadContent>
    <meta name="description"
          content="The latest news, tournament updates, and announcements from NEBA — New England's premier scratch bowling tournament series." />
    <meta property="og:title" content="News - NEBA" />
    <meta property="og:description" content="The latest news, tournament updates, and announcements from NEBA — New England's premier scratch bowling tournament series." />
    <meta property="og:image" content="https://www.bowlneba.com/images/neba-logo.png" />
    <meta property="og:url" content="https://www.bowlneba.com/news" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
</HeadContent>

<div class="neba-space-y-6">

    <div class="page-title-bar">
        <div class="page-title-inner">
            <h1>News</h1>
            <p>The latest from NEBA</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <NebaAlert Severity="NotifySeverity.Error" Title="Error Loading Articles" Message="@_errorMessage" Dismissible="true"
                   OnDismiss="@(() => _errorMessage = null)" />
    }

    @if (_isLoading)
    {
        <div aria-busy="true" aria-label="Loading news articles" class="neba-space-y-6">

            @if (PageNumber == 1)
            {
                <div class="news-hero-skeleton">
                    <div class="hero-skeleton-img neba-skeleton"></div>
                    <div class="hero-skeleton-body">
                        <NebaSkeletonLoader Type="SkeletonType.Custom" Width="80px" Height="1.2rem" />
                        <NebaSkeletonLoader Type="SkeletonType.Custom" Width="55%" Height="0.75rem" />
                        <NebaSkeletonLoader Type="SkeletonType.Custom" Width="85%" Height="1.6rem" />
                        <NebaSkeletonLoader Type="SkeletonType.Custom" Width="75%" Height="1.4rem" />
                        <NebaSkeletonLoader Type="SkeletonType.Text" Rows="2" />
                        <NebaSkeletonLoader Type="SkeletonType.Custom" Width="140px" Height="2.25rem" />
                    </div>
                </div>
            }

            <div class="news-grid">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="neba-card skeleton-card">
                        <div class="neba-skeleton skeleton-card-img"></div>
                        <div class="skeleton-card-body">
                            <NebaSkeletonLoader Type="SkeletonType.Custom" Width="35%" Height="0.6rem" />
                            <NebaSkeletonLoader Type="SkeletonType.Custom" Width="80%" Height="1rem" />
                            <NebaSkeletonLoader Type="SkeletonType.Text" Rows="2" />
                        </div>
                    </div>
                }
            </div>

        </div>
    }
    else if (_articles is not null)
    {
        @if (_articles.Items.Count == 0)
        {
            <div class="news-empty">
                <span class="material-symbols-outlined" style="font-size: 3rem; color: var(--neba-gray-300, #CCCCCC);" aria-hidden="true">newspaper</span>
                <p class="news-empty-text">No articles published yet. Check back soon.</p>
            </div>
        }
        else
        {
            @if (PageNumber == 1)
            {
                var hero = _articles.Items.First();
                <div class="news-hero-wrap">
                    <a href="/news/@hero.Slug" class="news-hero" aria-label="Read: @hero.Title">
                        <div class="hero-img" aria-hidden="true">
                            @if (hero.HeaderImageUrl is not null)
                            {
                                <img src="@hero.HeaderImageUrl" alt="" class="w-full h-full object-cover" />
                            }
                        </div>
                        <div class="hero-body">
                            <div class="hero-featured-tag">&#11088; Latest</div>
                            <div class="hero-date">@hero.PublishDateUtc.ToString("MMMM d, yyyy")</div>
                            <h2 class="hero-title">@hero.Title</h2>
                            <p class="hero-excerpt">@hero.Excerpt</p>
                            <span class="neba-btn neba-btn-primary" style="width: fit-content;">
                                Read full story
                                <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                                </svg>
                            </span>
                        </div>
                    </a>
                    @* Sibling of the anchor, not a descendant: HTML5 disallows interactive content inside <a>,
                       and Blazor's enhanced navigation hijacks clicks anywhere within an anchor's subtree
                       regardless of a descendant button's own stopPropagation/preventDefault (see ArticleCard.razor). *@
                    <AuthorizeView Policy="@Permissions.DeleteArticle.PolicyName">
                        <Authorized>
                            <button type="button" class="hero-delete-btn" aria-label="Delete article" @onclick="@(() => RequestDelete(hero))">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M3 6h18" />
                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                    <path d="M10 11v6" />
                                    <path d="M14 11v6" />
                                </svg>
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>

                @if (_articles.Items.Count > 1)
                {
                    <div class="news-grid">
                        @foreach (var article in _articles.Items.Skip(1))
                        {
                            <ArticleCard Article="@article" OnDeleteRequested="RequestDelete" />
                        }
                    </div>
                }
            }
            else
            {
                <div class="news-grid">
                    @foreach (var article in _articles.Items)
                    {
                        <ArticleCard Article="@article" OnDeleteRequested="RequestDelete" />
                    }
                </div>
            }

            @if (_articles.TotalPages > 1)
            {
                <nav class="news-pagination" aria-label="Article pages">
                    @if (_articles.HasPreviousPage)
                    {
                        <a href="/news?page=@(PageNumber - 1)" class="page-btn" aria-label="Previous page">&#8249;</a>
                    }

                    @for (var p = 1; p <= _articles.TotalPages; p++)
                    {
                        var pageNum = p;
                        <a href="/news?page=@pageNum"
                           class="page-btn @(pageNum == PageNumber ? "active" : string.Empty)"
                           aria-label="Page @pageNum"
                           aria-current="@(pageNum == PageNumber ? "page" : null)">
                            @pageNum
                        </a>
                    }

                    @if (_articles.HasNextPage)
                    {
                        <a href="/news?page=@(PageNumber + 1)" class="page-btn" aria-label="Next page">&#8250;</a>
                    }
                </nav>
            }
        }
    }

</div>

<ConfirmActionModal IsOpen="@_isDeleteConfirmOpen"
                     Title="Delete article?"
                     Message="@(_articlePendingDelete is null ? string.Empty : $"This permanently removes \"{_articlePendingDelete.Title}\" and its images. This can't be undone.")"
                     IsBusy="@_isDeleteBusy"
                     OnConfirm="ConfirmDeleteAsync"
                     OnCancel="CancelDelete" />

@code {
    [Parameter, SupplyParameterFromQuery(Name = "page")]
    public int? Page { get; set; }

    private int PageNumber => Page is > 0 ? Page.Value : 1;

    private PaginationResponse<ArticleSummaryResponse>? _articles;
    private bool _isLoading = true;
    private string? _errorMessage;

    private ArticleSummaryResponse? _articlePendingDelete;
    private bool _isDeleteConfirmOpen;
    private bool _isDeleteBusy;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _articles = null;

        var result = await ApiExecutor.ExecuteAsync(
            "News",
            "ListArticles",
            ct => NewsApi.ListArticlesAsync(PageNumber, 10, ct));

        _isLoading = false;

        if (result.IsError)
        {
            _errorMessage = result.FirstError.Description;
            return;
        }

        _articles = result.Value;
    }

    private void RequestDelete(ArticleSummaryResponse article)
    {
        _articlePendingDelete = article;
        _isDeleteConfirmOpen = true;
    }

    private void CancelDelete()
    {
        _isDeleteConfirmOpen = false;
        _articlePendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_articlePendingDelete is null)
        {
            return;
        }

        _isDeleteBusy = true;

        var result = await ApiExecutor.ExecuteAsync(
            "News",
            "DeleteArticle",
            ct => NewsApi.DeleteArticleAsync(_articlePendingDelete.ArticleId, ct));

        _isDeleteBusy = false;
        _isDeleteConfirmOpen = false;

        if (result.IsError)
        {
            ToastService.Show("Delete Failed", result.FirstError.Description, NotifySeverity.Error);
            _articlePendingDelete = null;
            return;
        }

        var deletedArticleId = _articlePendingDelete.ArticleId;
        var deletedArticleTitle = _articlePendingDelete.Title;
        _articlePendingDelete = null;

        if (_articles is not null)
        {
            _articles = _articles with
            {
                Items = [.. _articles.Items.Where(a => a.ArticleId != deletedArticleId)],
                TotalItems = Math.Max(0, _articles.TotalItems - 1),
            };
        }

        ToastService.Show("Article Deleted", $"\"{deletedArticleTitle}\" was successfully deleted.", NotifySeverity.Success);
    }
}
