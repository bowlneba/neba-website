@page "/news/new"
@using System.ComponentModel.DataAnnotations
@using ErrorOr
@using Neba.Api.Contracts.News
@using Neba.Api.Contracts.News.CreateArticle
@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Tournaments
@using Neba.Api.Contracts.Uploads
@using Neba.Website.Server.Notifications
@using Neba.Website.Server.Services
@using Neba.Website.Server.Tournaments
@using Neba.Website.Server.Tournaments.Schedule
@using Refit
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ApiExecutor ApiExecutor
@inject INewsApi NewsApi
@inject ITournamentApiService TournamentApiService
@inject ITournamentsApi TournamentsApi
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject IJSRuntime JsRuntime

<PageTitle>Create Article - BowlNEBA</PageTitle>

<AuthorizeView Policy="@Permissions.CreateArticle.PolicyName" Context="authContext">
    <Authorized>
        <div class="neba-space-y-6">

            <div class="page-title-bar">
                <div class="page-title-inner">
                    <h1>Create Article</h1>
                    <p>Write a new news article for BowlNEBA</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <NebaAlert Severity="NotifySeverity.Error" Title="Unable to Create Article" Message="@_errorMessage" Dismissible="true"
                           OnDismiss="@(() => _errorMessage = null)" />
            }

            <DirtyFormGuard IsDirty="@_isDirty" />

            <div class="neba-card">
                <EditForm EditContext="_editContext" FormName="CreateArticleForm" OnValidSubmit="HandleCreateAsync">
                    <DataAnnotationsValidator />
                    <div class="neba-space-y-4">

                        <div>
                            <label for="title" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Title</label>
                            <InputText id="title" @bind-Value="_model.Title" class="neba-input" placeholder="Article title" />
                            <ValidationMessage For="@(() => _model.Title)" class="block text-sm text-red-600 mt-1" />
                        </div>

                        <div>
                            <label for="slug" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Slug</label>
                            <InputText id="slug" @bind-Value="_model.Slug" class="neba-input" placeholder="@SlugPlaceholder" />
                            <p class="text-sm text-[var(--neba-gray-500)] mt-1">
                                Leave blank to auto-generate from the title.
                            </p>
                            <ValidationMessage For="@(() => _model.Slug)" class="block text-sm text-red-600 mt-1" />
                        </div>

                        <div>
                            <label for="content" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Content</label>
                            <RichTextEditor Value="@_model.Content" ValueChanged="HandleContentChanged" Placeholder="Write the article content…" OnImageSelected="HandleInlineImageSelectedAsync" />
                            <ValidationMessage For="@(() => _model.Content)" class="block text-sm text-red-600 mt-1" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Tournament</label>
                            @if (_deepLinkedTournamentName is not null)
                            {
                                <p class="neba-input" style="background:var(--neba-gray-050,#FAFAFA);">@_deepLinkedTournamentName</p>
                            }
                            else if (_isLoadingTournamentOptions)
                            {
                                <p class="text-sm text-[var(--neba-gray-500)]">Loading seasons and tournaments…</p>
                            }
                            else
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <select class="neba-select" value="@_selectedSeasonId" @onchange="HandleSeasonChangedAsync">
                                            @foreach (var season in _seasons)
                                            {
                                                <option value="@season.Id">@season.Description</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <select class="neba-select" value="@_model.TournamentId" @onchange="HandleTournamentChanged">
                                            <option value="">No tournament</option>
                                            @foreach (var tournament in _tournaments)
                                            {
                                                <option value="@tournament.Id">@tournament.Name</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Header Image</label>
                            <FileUpload MaxFiles="1" Accept="image/*" MaxFileSizeBytes="@(5 * 1024 * 1024)" Label="Upload a header image"
                                        OnUploadRequestedAsync="UploadHeaderImageAsync"
                                        OnFileUploaded="@(response => { _headerImage = response; MarkDirty(); })"
                                        OnFileRemoved="@(_ => { _headerImage = null; MarkDirty(); })"
                                        OnBusyChanged="@(busy => _isHeaderImageUploading = busy)" />
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Attachments</label>
                            <FileUpload MaxFiles="10" Accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" MaxFileSizeBytes="@(25 * 1024 * 1024)" Label="Upload attachments"
                                        OnUploadRequestedAsync="UploadAttachmentAsync"
                                        OnFileUploaded="@(response => { AddAttachment(response, isInline: false); MarkDirty(); })"
                                        OnFileRemoved="@(response => { RemoveAttachmentByUpload(response); MarkDirty(); })"
                                        OnBusyChanged="@(busy => _isAttachmentsUploading = busy)" />
                        </div>

                        @if (_attachments.Count > 0)
                        {
                            <div>
                                <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Files</label>
                                <ul class="create-article-attachment-list">
                                    @foreach (var attachment in _attachments)
                                    {
                                        <li class="create-article-attachment-row">
                                            <span class="create-article-attachment-name">@attachment.DisplayName</span>
                                            @if (attachment.IsInline)
                                            {
                                                <span class="create-article-attachment-badge" title="Used in article body">Inline</span>
                                            }
                                            <a href="@attachment.Upload.Url" download="@attachment.DisplayName" class="neba-btn neba-btn-secondary create-article-attachment-action">Download</a>
                                            <a href="@attachment.Upload.Url" target="_blank" rel="noopener noreferrer" class="neba-btn neba-btn-secondary create-article-attachment-action">Open</a>
                                            <button type="button" class="neba-btn neba-btn-danger create-article-attachment-action" @onclick="@(() => RequestRemoveAttachment(attachment))">Remove</button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="publication-status" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Status</label>
                                <InputSelect id="publication-status" @bind-Value="_model.PublicationStatus" class="neba-select">
                                    <option value="Draft">Draft</option>
                                    <option value="Published">Published</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => _model.PublicationStatus)" class="block text-sm text-red-600 mt-1" />
                            </div>

                            <div>
                                <label for="publish-date" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Publish Date</label>
                                <InputDate id="publish-date" Type="InputDateType.DateTimeLocal" @bind-Value="_model.PublishDateLocal" class="neba-input" />
                                <ValidationMessage For="@(() => _model.PublishDateLocal)" class="block text-sm text-red-600 mt-1" />
                            </div>
                        </div>

                        @if (_isHeaderImageUploading || _isAttachmentsUploading)
                        {
                            <p class="text-sm text-[var(--neba-gray-500)]">Uploading files…</p>
                        }

                        <div class="flex items-center gap-3">
                            <button type="submit" class="neba-btn neba-btn-primary" disabled="@(_isSubmitting || _isHeaderImageUploading || _isAttachmentsUploading)">
                                @(_isSubmitting ? "Creating…" : "Create Article")
                            </button>
                            <button type="button" class="neba-btn neba-btn-secondary" @onclick="HandleCancel" disabled="@_isSubmitting">
                                Cancel
                            </button>
                        </div>

                    </div>
                </EditForm>
            </div>

        </div>
    </Authorized>
    <NotAuthorized>
        <div class="news-empty">
            <p class="news-empty-text">You don't have permission to create articles.</p>
            <a href="/news" class="neba-btn neba-btn-secondary">Back to News</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

<ConfirmActionModal IsOpen="@_isRemoveInlineConfirmOpen"
                     Title="Remove embedded image?"
                     Message="This image is embedded in the article body. Removing it will leave a broken image where it appears — you'll need to edit the article body to remove or replace it."
                     ConfirmLabel="Remove"
                     OnConfirm="ConfirmRemoveAttachment"
                     OnCancel="CancelRemoveAttachment" />

@code {
    private readonly CreateArticleFormModel _model = new();
    private readonly EditContext _editContext;

    private IJSObjectReference? _jsModule;
    private bool _isSubmitting;
    private bool _isDirty;
    private string? _errorMessage;

    public CreateArticle()
    {
        _editContext = new EditContext(_model);
        _editContext.OnFieldChanged += HandleFieldChanged;
    }

    private UploadedFileResponse? _headerImage;
    private bool _isHeaderImageUploading;
    private bool _isAttachmentsUploading;
    private readonly List<TrackedAttachment> _attachments = [];
    private TrackedAttachment? _attachmentPendingRemoval;
    private bool _isRemoveInlineConfirmOpen;

    private List<SeasonViewModel> _seasons = [];
    private List<SeasonTournamentViewModel> _tournaments = [];
    private string? _selectedSeasonId;
    private string? _deepLinkedTournamentName;
    private bool _isLoadingTournamentOptions = true;

    /// <summary>
    /// Deep-links this page from a tournament-portal context: pre-selects and locks in the tournament
    /// (season/tournament picker hidden) rather than requiring staff to re-find it in the dropdowns.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "tournamentId")]
    public string? TournamentId { get; set; }

    private string SlugPlaceholder => SlugPreviewGenerator.Generate(_model.Title);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(TournamentId))
            {
                _model.TournamentId = TournamentId;

                var result = await ApiExecutor.ExecuteAsync(
                    "Tournaments",
                    "GetTournament",
                    ct => TournamentsApi.GetTournamentAsync(TournamentId, ct));

                _deepLinkedTournamentName = result.IsError
                    ? "Tournament " + TournamentId
                    : result.Value.Name;

                return;
            }

            (_seasons, _selectedSeasonId, _tournaments) = await ArticleTournamentPickerHelper.LoadDefaultSeasonAsync(TournamentApiService);
        }
        finally
        {
            _isLoadingTournamentOptions = false;
        }
    }

    private async Task LoadTournamentsForSeasonAsync(SeasonViewModel season)
    {
        var tournamentsResult = await TournamentApiService.GetTournamentsForSeasonAsync(season);
        _tournaments = tournamentsResult.IsError ? [] : tournamentsResult.Value;
    }

    private async Task HandleSeasonChangedAsync(ChangeEventArgs e)
    {
        _selectedSeasonId = e.Value?.ToString();
        _model.TournamentId = null;

        var season = _seasons.Find(s => s.Id == _selectedSeasonId);
        if (season is not null)
        {
            await LoadTournamentsForSeasonAsync(season);
        }
    }

    private void HandleTournamentChanged(ChangeEventArgs e)
    {
        _model.TournamentId = e.Value?.ToString();
        MarkDirty();
    }

    private void MarkDirty() => _isDirty = true;

    private void HandleContentChanged(string value)
    {
        _model.Content = value;
        MarkDirty();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e) => MarkDirty();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/browser-time.js");
        }
    }

    private async Task HandleCreateAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var publishDate = await ToLocalDateTimeOffsetAsync(_model.PublishDateLocal);

        var request = new CreateArticleRequest
        {
            Article = new ArticleInput
            {
                Title = _model.Title,
                Slug = string.IsNullOrWhiteSpace(_model.Slug) ? null : _model.Slug,
                Content = _model.Content,
                PublicationStatus = _model.PublicationStatus,
                PublishDate = publishDate,
                TournamentId = string.IsNullOrWhiteSpace(_model.TournamentId) ? null : _model.TournamentId,
                HeaderImage = _headerImage is null ? null : new HeaderImageInput
                {
                    Container = _headerImage.Container,
                    Path = _headerImage.Path,
                    ContentType = _headerImage.ContentType,
                    SizeInBytes = _headerImage.SizeInBytes
                },
                Attachments = [.. _attachments.Select(a => new AttachmentInput
                {
                    DisplayName = a.DisplayName,
                    IsInline = a.IsInline,
                    Container = a.Upload.Container,
                    Path = a.Upload.Path,
                    ContentType = a.Upload.ContentType,
                    SizeInBytes = a.Upload.SizeInBytes
                })],
            },
        };

        var result = await ApiExecutor.ExecuteAsync(
            "News",
            "CreateArticle",
            ct => NewsApi.CreateArticleAsync(request, ct));

        _isSubmitting = false;

        if (result.IsError)
        {
            _errorMessage = result.FirstError.Description;
            return;
        }

        _isDirty = false;
        ToastService.Show("Article Created", "\"" + _model.Title + "\" was successfully created.", NotifySeverity.Success);

        // DirtyFormGuard is a child component: its IsDirty parameter only reflects the line above once
        // this component re-renders and the render is actually processed. StateHasChanged() alone only
        // queues that render on the renderer's dispatch queue — it will not run until this method yields.
        // Without the Task.Yield() below, NavigateTo would run the NavigationLock's before-navigate check
        // against the guard's stale (still-dirty) parameter and incorrectly show the discard-changes
        // prompt on a successful save.
        StateHasChanged();
        await Task.Yield();

        NavigationManager.NavigateTo($"/news/{result.Value.Slug}");
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo("/news");
    }

    private async Task<ErrorOr<UploadedFileResponse>> UploadHeaderImageAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleHeaderImage",
            c => NewsApi.UploadArticleHeaderImageAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private async Task<ErrorOr<UploadedFileResponse>> UploadAttachmentAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleAttachment",
            c => NewsApi.UploadArticleAttachmentAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private void AddAttachment(UploadedFileResponse upload, bool isInline)
        => _attachments.Add(new TrackedAttachment
        {
            DisplayName = upload.FileName,
            IsInline = isInline,
            Upload = upload
        });

    private void RemoveAttachmentByUpload(UploadedFileResponse upload)
        => _attachments.RemoveAll(a => a.Upload.Container == upload.Container && a.Upload.Path == upload.Path);

    private void RequestRemoveAttachment(TrackedAttachment attachment)
    {
        if (!attachment.IsInline)
        {
            _attachments.Remove(attachment);
            return;
        }

        _attachmentPendingRemoval = attachment;
        _isRemoveInlineConfirmOpen = true;
    }

    private void ConfirmRemoveAttachment()
    {
        if (_attachmentPendingRemoval is not null)
        {
            _attachments.Remove(_attachmentPendingRemoval);
            MarkDirty();
        }

        _attachmentPendingRemoval = null;
        _isRemoveInlineConfirmOpen = false;
    }

    private void CancelRemoveAttachment()
    {
        _attachmentPendingRemoval = null;
        _isRemoveInlineConfirmOpen = false;
    }

    /// <summary>
    /// Wired to <c>RichTextEditor.OnImageSelected</c>: uploads an image picked/dropped directly in the
    /// editor via the same attachment endpoint <see cref="FileUpload" /> uses, tracks it as an inline
    /// attachment, and returns the resulting URL for Quill to embed at the cursor. Returns null (aborting
    /// the embed) if the upload fails.
    /// </summary>
    private async Task<string?> HandleInlineImageSelectedAsync(IJSStreamReference fileStream, string fileName, string contentType)
    {
        await using var stream = await fileStream.OpenReadStreamAsync(25 * 1024 * 1024);

        var result = await UploadAttachmentAsync(stream, fileName, contentType, new Progress<int>(), CancellationToken.None);

        if (result.IsError)
        {
            ToastService.Show("Image Upload Failed", result.FirstError.Description, NotifySeverity.Error);
            return null;
        }

        AddAttachment(result.Value, isInline: true);
        MarkDirty();
        StateHasChanged();

        return result.Value.Url.ToString();
    }

    private sealed class TrackedAttachment
    {
        public required string DisplayName { get; init; }

        public required bool IsInline { get; init; }

        public required UploadedFileResponse Upload { get; init; }
    }

    /// <summary>
    /// Attaches the browser's real UTC offset to a wall-clock value from the
    /// &lt;input type="datetime-local"&gt; element (which carries no timezone info on its own), producing
    /// a self-describing <see cref="DateTimeOffset"/> the API can convert to UTC itself.
    /// <c>Date.getTimezoneOffset()</c> returns minutes to ADD to local time to reach UTC (e.g. +300 for
    /// US Eastern), i.e. the negation of the actual UTC offset.
    /// </summary>
    private async Task<DateTimeOffset> ToLocalDateTimeOffsetAsync(DateTime localValue)
    {
        var unspecifiedLocalValue = DateTime.SpecifyKind(localValue, DateTimeKind.Unspecified);

        if (_jsModule is null)
        {
            return new DateTimeOffset(unspecifiedLocalValue, TimeSpan.Zero);
        }

        var timezoneOffsetMinutes = await _jsModule.InvokeAsync<int>("getTimezoneOffsetMinutes");
        return new DateTimeOffset(unspecifiedLocalValue, TimeSpan.FromMinutes(-timezoneOffsetMinutes));
    }

    public async ValueTask DisposeAsync()
    {
        _editContext.OnFieldChanged -= HandleFieldChanged;

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up.
            }
        }
    }

    private sealed class CreateArticleFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        [StringLength(256, ErrorMessage = "Title must be 256 characters or fewer.")]
        public string Title { get; set; } = string.Empty;

        [StringLength(256, ErrorMessage = "Slug must be 256 characters or fewer.")]
        public string? Slug { get; set; }

        [Required(ErrorMessage = "Content is required.")]
        public string Content { get; set; } = string.Empty;

        [Required(ErrorMessage = "Status is required.")]
        public string PublicationStatus { get; set; } = "Draft";

        [Required(ErrorMessage = "Publish date is required.")]
        public DateTime PublishDateLocal { get; set; } = DateTime.Now;

        public string? TournamentId { get; set; }
    }
}
