@page "/news/{Slug}/edit"
@using System.ComponentModel.DataAnnotations
@using ErrorOr
@using Neba.Api.Contracts.News
@using Neba.Api.Contracts.News.CreateArticle
@using Neba.Api.Contracts.News.EditArticle
@using Neba.Api.Contracts.News.GetArticle
@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Tournaments
@using Neba.Api.Contracts.Uploads
@using Neba.Website.Server.Services
@using Neba.Website.Server.Time
@using Refit
@implements IAsyncDisposable
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ApiExecutor ApiExecutor
@inject INewsApi NewsApi
@inject ITournamentApiService TournamentApiService
@inject ITournamentsApi TournamentsApi
@inject NavigationManager NavigationManager
@inject ToastService ToastService
@inject IClientTimeZoneService ClientTimeZoneService

<PageTitle>@(_article is not null ? "Edit " + _article.Title + " - BowlNEBA" : "Edit Article - BowlNEBA")</PageTitle>

<AuthorizeView Policy="@Permissions.EditArticle.PolicyName" Context="authContext">
    <Authorized>

        @if (_isLoading)
        {
            <div class="neba-space-y-6" aria-busy="true" aria-label="Loading article">
                <NebaSkeletonLoader Type="SkeletonType.Custom" Width="65%" Height="2rem" />
                <NebaSkeletonLoader Type="SkeletonType.Text" Rows="6" />
            </div>
        }
        else if (_notFound)
        {
            <div class="news-empty">
                <p class="news-empty-text">This article could not be found.</p>
                <a href="/news" class="neba-btn neba-btn-secondary">Back to News</a>
            </div>
        }
        else if (_article is null)
        {
            <NebaAlert Severity="NotifySeverity.Error" Title="Unable to Load Article" Message="@_loadErrorMessage" Dismissible="false" />
        }
        else
        {
            <div class="neba-space-y-6">

                <div class="page-title-bar">
                    <div class="page-title-inner">
                        <h1>Edit Article</h1>
                        <p>Update "@_article.Title"</p>
                    </div>
                    <div class="page-title-help">
                        <HelpButton DocName="edit-article" Light="true" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <NebaAlert Severity="NotifySeverity.Error" Title="Unable to Save Article" Message="@_errorMessage" Dismissible="true"
                               OnDismiss="@(() => _errorMessage = null)" />
                }

                <DirtyFormGuard IsDirty="@_isDirty" />

                <div class="neba-card">
                    <EditForm EditContext="_editContext" FormName="EditArticleForm" OnValidSubmit="HandleSaveAsync">
                        <DataAnnotationsValidator />
                        <div class="neba-space-y-4">

                            <div>
                                <FormLabel TargetId="title" For="@(() => _model.Title)">Title</FormLabel>
                                <InputText id="title" @bind-Value="_model.Title" class="neba-input" placeholder="Article title" aria-describedby="title-error" />
                                <NebaValidationMessage For="@(() => _model.Title)" Id="title-error" Class="block text-sm text-red-600 mt-1" />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Slug</label>
                                <p class="neba-input" style="background:var(--neba-gray-050,#FAFAFA);">@_article.Slug</p>
                                <p class="text-sm text-[var(--neba-gray-500)] mt-1">
                                    The slug cannot be changed after an article is created.
                                </p>
                            </div>

                            <div>
                                <FormLabel TargetId="content" For="@(() => _model.Content)">Content</FormLabel>
                                <RichTextEditor Value="@_model.Content" ValueChanged="HandleContentChanged" Placeholder="Write the article content…" OnImageSelected="HandleInlineImageSelectedAsync" />
                                <NebaValidationMessage For="@(() => _model.Content)" Id="content-error" Class="block text-sm text-red-600 mt-1" />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Tournament</label>
                                @if (_deepLinkedTournamentName is not null)
                                {
                                    <p class="neba-input" style="background:var(--neba-gray-050,#FAFAFA);">@_deepLinkedTournamentName</p>
                                    <button type="button" class="neba-btn neba-btn-secondary" style="margin-top:0.5rem;" @onclick="SwitchToTournamentPicker">
                                        Change tournament
                                    </button>
                                }
                                else if (_isLoadingTournamentOptions)
                                {
                                    <p class="text-sm text-[var(--neba-gray-500)]">Loading seasons and tournaments…</p>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                        <div>
                                            <select class="neba-select" value="@_selectedSeasonId" @onchange="HandleSeasonChangedAsync">
                                                @foreach (var season in _seasons)
                                                {
                                                    <option value="@season.Id">@season.Description</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <select class="neba-select" value="@_model.TournamentId" @onchange="HandleTournamentChanged">
                                                <option value="">No tournament</option>
                                                @foreach (var tournament in _tournaments)
                                                {
                                                    <option value="@tournament.Id">@tournament.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Header Image</label>
                                @if (_headerImage is not null)
                                {
                                    <div class="edit-article-current-file">
                                        @if (_headerImage.Url is not null)
                                        {
                                            <img src="@_headerImage.Url" alt="" class="edit-article-header-preview" />
                                        }
                                        <button type="button" class="neba-btn neba-btn-secondary" @onclick="RemoveHeaderImage">Remove current image</button>
                                    </div>
                                }
                                <FileUpload MaxFiles="1" Accept="image/*" MaxFileSizeBytes="@(5 * 1024 * 1024)" Label="Upload a replacement header image"
                                            OnUploadRequestedAsync="UploadHeaderImageAsync"
                                            OnFileUploaded="@(response => { _headerImage = ToHeaderImageRef(response); MarkDirty(); })"
                                            OnFileRemoved="@(_ => { _headerImage = null; MarkDirty(); })"
                                            OnBusyChanged="@(busy => _isHeaderImageUploading = busy)" />
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Attachments</label>
                                <FileUpload MaxFiles="10" Accept=".pdf,.doc,.docx,.xls,.xlsx,image/*" MaxFileSizeBytes="@(25 * 1024 * 1024)" Label="Upload attachments"
                                            OnUploadRequestedAsync="UploadAttachmentAsync"
                                            OnFileUploaded="@(response => { AddAttachment(response, isInline: false); MarkDirty(); })"
                                            OnFileRemoved="@(response => { RemoveAttachmentByUpload(response); MarkDirty(); })"
                                            OnBusyChanged="@(busy => _isAttachmentsUploading = busy)" />
                            </div>

                            @if (_attachments.Count > 0)
                            {
                                <div>
                                    <label class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Files</label>
                                    <ul class="edit-article-attachment-list">
                                        @foreach (var attachment in _attachments)
                                        {
                                            <li class="edit-article-attachment-row">
                                                <span class="edit-article-attachment-name">@attachment.DisplayName</span>
                                                @if (attachment.IsInline)
                                                {
                                                    <span class="edit-article-attachment-badge" title="Used in article body">Inline</span>
                                                }
                                                @if (attachment.Url is not null)
                                                {
                                                    <a href="@attachment.Url" download="@attachment.DisplayName" class="neba-btn neba-btn-secondary edit-article-attachment-action">Download</a>
                                                    <a href="@attachment.Url" target="_blank" rel="noopener noreferrer" class="neba-btn neba-btn-secondary edit-article-attachment-action">Open</a>
                                                }
                                                <button type="button" class="neba-btn neba-btn-danger edit-article-attachment-action" @onclick="@(() => RequestRemoveAttachment(attachment))">Remove</button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <FormLabel TargetId="publication-status" For="@(() => _model.PublicationStatus)">Status</FormLabel>
                                    <InputSelect id="publication-status" @bind-Value="_model.PublicationStatus" class="neba-select" aria-describedby="publication-status-error">
                                        <option value="Draft">Draft</option>
                                        <option value="Published">Published</option>
                                    </InputSelect>
                                    <NebaValidationMessage For="@(() => _model.PublicationStatus)" Id="publication-status-error" Class="block text-sm text-red-600 mt-1" />
                                </div>

                                <div>
                                    <FormLabel TargetId="publish-date" For="@(() => _model.PublishDateLocal)">Publish Date</FormLabel>
                                    <InputDate id="publish-date" Type="InputDateType.DateTimeLocal" @bind-Value="_model.PublishDateLocal" class="neba-input" aria-describedby="publish-date-error" />
                                    <NebaValidationMessage For="@(() => _model.PublishDateLocal)" Id="publish-date-error" Class="block text-sm text-red-600 mt-1" />
                                </div>
                            </div>

                            @if (_isHeaderImageUploading || _isAttachmentsUploading)
                            {
                                <p class="text-sm text-[var(--neba-gray-500)]">Uploading files…</p>
                            }

                            <div class="flex items-center gap-3">
                                <button type="submit" class="neba-btn neba-btn-primary" disabled="@(_isSubmitting || _isHeaderImageUploading || _isAttachmentsUploading)">
                                    @(_isSubmitting ? "Saving…" : "Save Changes")
                                </button>
                                <button type="button" class="neba-btn neba-btn-secondary" @onclick="HandleCancel" disabled="@_isSubmitting">
                                    Cancel
                                </button>
                            </div>

                        </div>
                    </EditForm>
                </div>

            </div>
        }

    </Authorized>
    <NotAuthorized>
        <div class="news-empty">
            <p class="news-empty-text">You don't have permission to edit articles.</p>
            <a href="/news" class="neba-btn neba-btn-secondary">Back to News</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

<ConfirmActionModal IsOpen="@_isRemoveInlineConfirmOpen"
                     Title="Remove embedded image?"
                     Message="This image is embedded in the article body. Removing it will leave a broken image where it appears — you'll need to edit the article body to remove or replace it."
                     ConfirmLabel="Remove"
                     OnConfirm="ConfirmRemoveAttachment"
                     OnCancel="CancelRemoveAttachment" />

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private readonly EditArticleFormModel _model = new();
    private readonly EditContext _editContext;

    private bool _isLoading = true;
    private bool _notFound;
    private bool _isSubmitting;
    private bool _isDirty;
    private string? _loadErrorMessage;
    private string? _errorMessage;
    private ArticleDetailResponse? _article;
    private string _articleId = string.Empty;

    public EditArticle()
    {
        _editContext = new EditContext(_model);
        _editContext.OnFieldChanged += HandleFieldChanged;
    }

    private HeaderImageRef? _headerImage;
    private bool _isHeaderImageUploading;
    private bool _isAttachmentsUploading;
    private readonly List<TrackedAttachment> _attachments = [];
    private TrackedAttachment? _attachmentPendingRemoval;
    private bool _isRemoveInlineConfirmOpen;

    private List<SeasonViewModel> _seasons = [];
    private List<SeasonTournamentViewModel> _tournaments = [];
    private string? _selectedSeasonId;
    private string? _deepLinkedTournamentName;
    private bool _isLoadingTournamentOptions = true;

    protected override async Task OnInitializedAsync()
    {
        var ct = CancellationToken.None;

        var result = await ApiExecutor.ExecuteAsync(
            "News",
            "GetArticle",
            c => NewsApi.GetArticleAsync(Slug, c),
            ct);

        _isLoading = false;

        if (result.IsError)
        {
            if (result.FirstError.Type == ErrorType.NotFound)
            {
                _notFound = true;
                return;
            }

            _loadErrorMessage = result.FirstError.Description;
            return;
        }

        _article = result.Value;
        _articleId = _article.ArticleId;

        _model.Title = _article.Title;
        _model.Content = _article.Content;
        _model.PublicationStatus = _article.PublicationStatus;
        _model.PublishDateLocal = (await ClientTimeZoneService.ToLocalAsync(_article.PublishDateUtc)).DateTime;
        _model.TournamentId = _article.TournamentId;

        if (_article.HeaderImageContainer is not null && _article.HeaderImagePath is not null)
        {
            _headerImage = new HeaderImageRef
            {
                Container = _article.HeaderImageContainer,
                Path = _article.HeaderImagePath,
                ContentType = _article.HeaderImageContentType ?? "application/octet-stream",
                SizeInBytes = _article.HeaderImageSizeInBytes ?? 0,
                Url = _article.HeaderImageUrl
            };
        }

        _attachments.AddRange(_article.Attachments
            .Where(a => a.Container is not null && a.Path is not null)
            .Select(a => new TrackedAttachment
            {
                DisplayName = a.DisplayName,
                IsInline = a.IsInline,
                Container = a.Container!,
                Path = a.Path!,
                ContentType = a.ContentType,
                SizeInBytes = a.SizeInBytes ?? 0,
                Url = a.Url
            }));

        if (!string.IsNullOrWhiteSpace(_article.TournamentId))
        {
            var tournamentResult = await ApiExecutor.ExecuteAsync(
                "Tournaments",
                "GetTournament",
                c => TournamentsApi.GetTournamentAsync(_article.TournamentId, c),
                ct);

            _deepLinkedTournamentName = tournamentResult.IsError
                ? "Tournament " + _article.TournamentId
                : tournamentResult.Value.Name;

            _isLoadingTournamentOptions = false;
            return;
        }

        // No tournament already assigned — show the season/tournament picker immediately rather than
        // waiting for a "Change tournament" button that only exists once a tournament IS assigned.
        await LoadSeasonPickerAsync();
    }

    private async Task SwitchToTournamentPicker()
    {
        _deepLinkedTournamentName = null;
        _isLoadingTournamentOptions = true;

        await LoadSeasonPickerAsync();
    }

    private async Task LoadSeasonPickerAsync()
    {
        try
        {
            (_seasons, _selectedSeasonId, _tournaments) = await ArticleTournamentPickerHelper.LoadDefaultSeasonAsync(TournamentApiService);
        }
        finally
        {
            _isLoadingTournamentOptions = false;
        }
    }

    private async Task LoadTournamentsForSeasonAsync(SeasonViewModel season)
    {
        var tournamentsResult = await TournamentApiService.GetTournamentsForSeasonAsync(season);
        _tournaments = tournamentsResult.IsError ? [] : tournamentsResult.Value;
    }

    private async Task HandleSeasonChangedAsync(ChangeEventArgs e)
    {
        _selectedSeasonId = e.Value?.ToString();
        _model.TournamentId = null;

        var season = _seasons.Find(s => s.Id == _selectedSeasonId);
        if (season is not null)
        {
            await LoadTournamentsForSeasonAsync(season);
        }
    }

    private void HandleTournamentChanged(ChangeEventArgs e)
    {
        _model.TournamentId = e.Value?.ToString();
        MarkDirty();
    }

    private void MarkDirty() => _isDirty = true;

    private void HandleContentChanged(string value)
    {
        _model.Content = value;
        MarkDirty();
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e) => MarkDirty();

    private async Task HandleSaveAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var publishDate = await ClientTimeZoneService.ToUtcAsync(_model.PublishDateLocal);

        var request = new EditArticleRequest
        {
            Id = _articleId,
            Article = new EditArticleInput
            {
                Title = _model.Title,
                Content = _model.Content,
                PublicationStatus = _model.PublicationStatus,
                PublishDate = publishDate,
                TournamentId = string.IsNullOrWhiteSpace(_model.TournamentId) ? null : _model.TournamentId,
                HeaderImage = _headerImage is null ? null : new HeaderImageInput
                {
                    Container = _headerImage.Container,
                    Path = _headerImage.Path,
                    ContentType = _headerImage.ContentType,
                    SizeInBytes = _headerImage.SizeInBytes
                },
                Attachments = [.. _attachments.Select(a => new AttachmentInput
                {
                    DisplayName = a.DisplayName,
                    IsInline = a.IsInline,
                    Container = a.Container,
                    Path = a.Path,
                    ContentType = a.ContentType,
                    SizeInBytes = a.SizeInBytes
                })],
            },
        };

        var result = await ApiExecutor.ExecuteAsync(
            "News",
            "EditArticle",
            ct => NewsApi.EditArticleAsync(_articleId, request, ct));

        _isSubmitting = false;

        if (result.IsError)
        {
            _errorMessage = result.FirstError.Description;
            return;
        }

        _isDirty = false;
        ToastService.Show("Article Updated", "\"" + _model.Title + "\" was successfully updated.", NotifySeverity.Success);

        // See CreateArticle.razor's HandleCreateAsync for why the render must be allowed to process
        // before navigating: without it, NavigateTo runs the NavigationLock's before-navigate check
        // against the guard's stale (still-dirty) parameter and incorrectly shows the discard prompt.
        StateHasChanged();
        await Task.Yield();

        NavigationManager.NavigateTo($"/news/{Slug}");
    }

    private void HandleCancel()
    {
        NavigationManager.NavigateTo($"/news/{Slug}");
    }

    private async Task<ErrorOr<UploadedFileResponse>> UploadHeaderImageAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleHeaderImage",
            c => NewsApi.UploadArticleHeaderImageAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private async Task<ErrorOr<UploadedFileResponse>> UploadAttachmentAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleAttachment",
            c => NewsApi.UploadArticleAttachmentAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private static HeaderImageRef ToHeaderImageRef(UploadedFileResponse upload)
        => new()
        {
            Container = upload.Container,
            Path = upload.Path,
            ContentType = upload.ContentType,
            SizeInBytes = upload.SizeInBytes,
            Url = upload.Url
        };

    private void RemoveHeaderImage()
    {
        _headerImage = null;
        MarkDirty();
    }

    private void AddAttachment(UploadedFileResponse upload, bool isInline)
        => _attachments.Add(new TrackedAttachment
        {
            DisplayName = upload.FileName,
            IsInline = isInline,
            Container = upload.Container,
            Path = upload.Path,
            ContentType = upload.ContentType,
            SizeInBytes = upload.SizeInBytes,
            Url = upload.Url
        });

    private void RemoveAttachmentByUpload(UploadedFileResponse upload)
        => _attachments.RemoveAll(a => a.Container == upload.Container && a.Path == upload.Path);

    private void RequestRemoveAttachment(TrackedAttachment attachment)
    {
        if (!attachment.IsInline)
        {
            _attachments.Remove(attachment);
            MarkDirty();
            return;
        }

        _attachmentPendingRemoval = attachment;
        _isRemoveInlineConfirmOpen = true;
    }

    private void ConfirmRemoveAttachment()
    {
        if (_attachmentPendingRemoval is not null)
        {
            _attachments.Remove(_attachmentPendingRemoval);
            MarkDirty();
        }

        _attachmentPendingRemoval = null;
        _isRemoveInlineConfirmOpen = false;
    }

    private void CancelRemoveAttachment()
    {
        _attachmentPendingRemoval = null;
        _isRemoveInlineConfirmOpen = false;
    }

    /// <summary>
    /// Wired to <c>RichTextEditor.OnImageSelected</c>: uploads an image picked/dropped directly in the
    /// editor via the same attachment endpoint <see cref="FileUpload" /> uses, tracks it as an inline
    /// attachment, and returns the resulting URL for Quill to embed at the cursor. Returns null (aborting
    /// the embed) if the upload fails.
    /// </summary>
    private async Task<string?> HandleInlineImageSelectedAsync(IJSStreamReference fileStream, string fileName, string contentType)
    {
        await using var stream = await fileStream.OpenReadStreamAsync(25 * 1024 * 1024);

        var result = await UploadAttachmentAsync(stream, fileName, contentType, new Progress<int>(), CancellationToken.None);

        if (result.IsError)
        {
            ToastService.Show("Image Upload Failed", result.FirstError.Description, NotifySeverity.Error);
            return null;
        }

        AddAttachment(result.Value, isInline: true);
        MarkDirty();
        StateHasChanged();

        return result.Value.Url.ToString();
    }

    private sealed class HeaderImageRef
    {
        public required string Container { get; init; }

        public required string Path { get; init; }

        public required string ContentType { get; init; }

        public required long SizeInBytes { get; init; }

        public Uri? Url { get; init; }
    }

    private sealed class TrackedAttachment
    {
        public required string DisplayName { get; init; }

        public required bool IsInline { get; init; }

        public required string Container { get; init; }

        public required string Path { get; init; }

        public required string ContentType { get; init; }

        public required long SizeInBytes { get; init; }

        public Uri? Url { get; init; }
    }

    public ValueTask DisposeAsync()
    {
        _editContext.OnFieldChanged -= HandleFieldChanged;
        return ValueTask.CompletedTask;
    }

    private sealed class EditArticleFormModel
    {
        [Required(ErrorMessage = "Title is required.")]
        [StringLength(256, ErrorMessage = "Title must be 256 characters or fewer.")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Content is required.")]
        public string Content { get; set; } = string.Empty;

        [Required(ErrorMessage = "Status is required.")]
        public string PublicationStatus { get; set; } = "Draft";

        [Required(ErrorMessage = "Publish date is required.")]
        public DateTime PublishDateLocal { get; set; } = DateTime.Now;

        public string? TournamentId { get; set; }
    }
}
