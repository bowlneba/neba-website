@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Neba.Api.Contracts.Security
@using Neba.Website.Server.Account
@using Neba.Website.Server.Services
@implements IAsyncDisposable
@inject IHttpContextAccessor HttpContextAccessor
@inject CircuitTokenCache TokenCache
@inject IJSRuntime JsRuntime
@inject ToastService ToastService

<AuthorizeView>
    <Authorized>
        <div class="account-menu">
            <button type="button" class="account-trigger" aria-haspopup="true" aria-expanded="false">
                <svg class="account-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12zm0 2.4c-3.3 0-9.8 1.6-9.8 4.9v2.5h19.6v-2.5c0-3.3-6.5-4.9-9.8-4.9z" />
                </svg>
                <span class="sr-only">Account menu</span>
            </button>
            <div class="account-dropdown" role="menu">
                <span class="account-email">@context.User.FindFirst(ClaimTypes.Email)?.Value</span>
                <div class="account-divider"></div>
                <AuthorizeView Policy="@Permissions.CreateUser.PolicyName" Context="createUserContext">
                    <Authorized>
                        <a class="account-dropdown-link" href="/account/create-user" role="menuitem" data-enhance-nav="false">Create User</a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Policy="@Permissions.GetUsers.PolicyName" Context="usersContext">
                    <Authorized>
                        <a class="account-dropdown-link" href="/account/users" role="menuitem" data-enhance-nav="false">Users</a>
                    </Authorized>
                </AuthorizeView>
                @if (IsDebugBuild)
                {
                    <div class="account-divider"></div>
                    <button type="button" class="account-dropdown-link" role="menuitem" @onclick="CopyTokenAsync">Copy Auth Token</button>
                }
                <div class="account-divider"></div>
                <a class="account-dropdown-link" href="/account/logout" role="menuitem" data-enhance-nav="false">Logout</a>

            </div>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private IJSObjectReference? _module;

    private static bool IsDebugBuild
    {
        get
        {
#if DEBUG
            return true;
#else
            return false;
#endif
        }
    }

    private async Task CopyTokenAsync()
    {
        if (!IsDebugBuild)
            return;

        var httpContext = HttpContextAccessor.HttpContext;
        var token = httpContext is not null
            ? await httpContext.GetTokenAsync(CookieAuthenticationDefaults.AuthenticationScheme, SecurityClaimsBuilder.AccessTokenName)
            : TokenCache.AccessToken;

        if (token is null)
        {
            ToastService.Show("Copy Token Failed", "No access token was found for the current session.", NotifySeverity.Error);
            return;
        }

        _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Layout/AccountMenu.razor.js");
        await _module.InvokeVoidAsync("copyToClipboard", token);

        ToastService.Show("Token Copied", "Access token copied to clipboard.", NotifySeverity.Success);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
