@inject Neba.Website.Server.Services.NebaApiConfiguration ApiConfiguration
@inject IHttpClientFactory HttpClientFactory
@inject Neba.Website.Server.Notifications.ToastService ToastService
@inject NavigationManager Nav

@if (IsDebugBuild)
{
    <div class="debug-banner-actions">
        <button class="debug-banner-link" @onclick="ClearApiCacheAsync" type="button">Clear API Cache</button>
        <button class="debug-banner-link" @onclick="ClearAuditTablesAsync" type="button">Clear Audit Tables</button>
        <a class="debug-banner-link" href="@AdminLoginUrl">Log in as Admin</a>
    </div>
}

@code {
    private string AdminLoginUrl
    {
        get
        {
            var currentPath = Nav.ToBaseRelativePath(Nav.Uri);
            var returnUrl = Uri.EscapeDataString("/" + currentPath);
            return $"/account/login?admin=true&ReturnUrl={returnUrl}";
        }
    }

    private static bool IsDebugBuild
    {
        get
        {
#if DEBUG
            return true;
#else
            return false;
#endif
        }
    }

    private async Task ClearApiCacheAsync()
    {
        if (!IsDebugBuild)
            return;

        try
        {
            using var client = HttpClientFactory.CreateClient();
            using var response = await client.GetAsync(new Uri(ApiConfiguration.BaseUrl, "/debug/cache"));

            if (response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                ToastService.Show("API Cache Cleared",
                    string.IsNullOrWhiteSpace(message) ? "Cache was cleared." : message,
                    NotifySeverity.Success);
            }
            else
            {
                ToastService.Show("Cache Clear Failed", $"API returned {(int)response.StatusCode}.", NotifySeverity.Error);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Cache Clear Failed", ex.Message, NotifySeverity.Error);
        }
    }

    private async Task ClearAuditTablesAsync()
    {
        if (!IsDebugBuild)
            return;

        try
        {
            using var client = HttpClientFactory.CreateClient();
            using var response = await client.GetAsync(new Uri(ApiConfiguration.BaseUrl, "/debug/clear-audits"));

            if (response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                ToastService.Show("Audit Tables Cleared",
                    string.IsNullOrWhiteSpace(message) ? "Audit tables were cleared." : message,
                    NotifySeverity.Success);
            }
            else
            {
                ToastService.Show("Clear Audit Tables Failed", $"API returned {(int)response.StatusCode}.", NotifySeverity.Error);
            }
        }
        catch (Exception ex)
        {
            ToastService.Show("Clear Audit Tables Failed", ex.Message, NotifySeverity.Error);
        }
    }
}
