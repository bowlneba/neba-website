@using ErrorOr
@using Neba.Api.Contracts.Tournaments.CreateTournament
@using Neba.Api.Contracts.Uploads

<DirtyFormGuard IsDirty="@(IsOpen && IsDirty)" />

<ConfirmActionModal IsOpen="@_isCancelConfirmOpen"
                    Title="Discard unsaved changes?"
                    Message="You have unsaved changes. If you close this dialog now, they will be lost."
                    ConfirmLabel="Discard"
                    CancelLabel="Keep Editing"
                    OnConfirm="ConfirmCancelAsync"
                    OnCancel="@(() => _isCancelConfirmOpen = false)" />

<NebaModal IsOpen="@IsOpen" OnClose="@HandleCancelRequestedAsync" MaxWidth="480px" CompactSize="true"
           AriaLabelledById="edit-logo-title">
    <HeaderContent>
        <div>
            <h2 class="neba-modal-title" id="edit-logo-title">Edit logo</h2>
            <div class="elm-subtitle">@TournamentName</div>
        </div>
    </HeaderContent>
    <ChildContent>
        @if (_errorMessage is not null)
        {
            <NebaAlert Severity="NotifySeverity.Error" Title="Couldn't Save Logo" Message="@_errorMessage"
                       Dismissible="true" OnDismiss="@(() => _errorMessage = null)" />
        }

        <div class="elm-preview">
            <div class="elm-tile @(ShownLogoUrl is null ? "elm-tile--none" : null)">
                @if (ShownLogoUrl is not null)
                {
                    <img src="@ShownLogoUrl.AbsoluteUri" alt="" />
                }
                else
                {
                    <span>No logo</span>
                }
            </div>

            <div>
                @if (_staged is not null)
                {
                    <span class="elm-badge">New logo</span>
                }
                <p class="elm-state">@StateLabel</p>
                <p class="elm-help">@StateHelp</p>

                @if (_staged is not null)
                {
                    <button type="button" class="elm-link-danger" @onclick="DiscardStaged">Discard new logo</button>
                }
                else if (CurrentLogoUrl is not null && !_removed)
                {
                    <button type="button" class="elm-link-danger" @onclick="RemoveCurrent">Remove current logo</button>
                }
            </div>
        </div>

        <FileUpload @key="_uploadKey" MaxFiles="1" Accept="image/*" MaxFileSizeBytes="@(5 * 1024 * 1024)"
                    Label="@(_staged is null ? "Upload a replacement logo" : "Upload a different logo")"
                    OnUploadRequestedAsync="OnUploadRequestedAsync"
                    OnFileUploaded="HandleFileUploaded"
                    OnFileRemoved="HandleFileRemoved"
                    OnBusyChanged="@(busy => _isUploading = busy)" />
    </ChildContent>
    <FooterContent>
        <div class="elm-actions">
            <button type="button" class="neba-btn neba-btn-secondary" @onclick="HandleCancelRequestedAsync" disabled="@_isSubmitting">Cancel</button>
            <button type="button" class="neba-btn neba-btn-primary" @onclick="SubmitAsync"
                    disabled="@(!IsDirty || _isUploading || _isSubmitting)">
                @(_isSubmitting ? "Saving..." : "Save logo")
            </button>
        </div>
    </FooterContent>
</NebaModal>

@code {
    [Parameter, EditorRequired]
    public bool IsOpen { get; set; }

    [Parameter, EditorRequired]
    public string TournamentName { get; set; } = string.Empty;

    /// <summary>
    /// The tournament's own logo, or null when it has none. Pass the real logo URL, never the
    /// default-artwork fallback, so the default is not shown as an uploaded logo.
    /// </summary>
    [Parameter]
    public Uri? CurrentLogoUrl { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSaved { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter, EditorRequired]
    public Func<Stream, string, string, IProgress<int>, CancellationToken, Task<ErrorOr<UploadedFileResponse>>> OnUploadRequestedAsync { get; set; } = default!;

    /// <summary>
    /// Saves the logo. A null input removes the current logo. Kept feature-agnostic, like
    /// <c>AddTournamentSponsorModal.OnSubmitRequestedAsync</c>; the host wires the real call.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<TournamentLogoInput?, CancellationToken, Task<ErrorOr<Success>>> OnSubmitRequestedAsync { get; set; } = default!;

    private UploadedFileResponse? _staged;
    private bool _removed;
    private bool _isUploading;
    private bool _isSubmitting;
    private bool _isCancelConfirmOpen;
    private string? _errorMessage;
    private Guid _uploadKey = Guid.NewGuid();

    private bool IsDirty => _staged is not null || _removed;

    private Uri? ShownLogoUrl
    {
        get
        {
            if (_staged is not null)
            {
                return _staged.Url;
            }

            return _removed ? null : CurrentLogoUrl;
        }
    }

    private string StateLabel
    {
        get
        {
            if (_staged is not null)
            {
                return "New logo";
            }

            if (_removed)
            {
                return "Logo will be removed";
            }

            return CurrentLogoUrl is not null ? "Current logo" : "No logo set";
        }
    }

    private string StateHelp
    {
        get
        {
            if (_staged is not null)
            {
                return "Replaces the current logo when you save.";
            }

            return _removed || CurrentLogoUrl is null
                ? "Visitors see the default artwork for this tournament type."
                : "This is what shows on the tournament page and the schedule.";
        }
    }

    private Task HandleFileUploaded(UploadedFileResponse upload)
    {
        _staged = upload;
        _removed = false;
        return Task.CompletedTask;
    }

    private Task HandleFileRemoved(UploadedFileResponse removed)
    {
        _staged = null;
        return Task.CompletedTask;
    }

    private void DiscardStaged()
    {
        _staged = null;
        _uploadKey = Guid.NewGuid();
    }

    private void RemoveCurrent()
        => _removed = true;

    private Task HandleCancelRequestedAsync()
    {
        if (IsDirty)
        {
            _isCancelConfirmOpen = true;
            return Task.CompletedTask;
        }

        return CloseAsync();
    }

    private Task ConfirmCancelAsync()
    {
        _isCancelConfirmOpen = false;
        return CloseAsync();
    }

    private Task CloseAsync()
    {
        ResetForm();
        return OnClose.InvokeAsync();
    }

    private void ResetForm()
    {
        _staged = null;
        _removed = false;
        _errorMessage = null;
        _uploadKey = Guid.NewGuid();
    }

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        var logo = _staged is null
            ? null
            : new TournamentLogoInput
            {
                Container = _staged.Container,
                Path = _staged.Path,
                ContentType = _staged.ContentType,
                SizeInBytes = _staged.SizeInBytes
            };

        var result = await OnSubmitRequestedAsync(logo, CancellationToken.None);

        _isSubmitting = false;

        if (result.IsError)
        {
            _errorMessage = result.FirstError.Description;
            return;
        }

        ResetForm();

        await OnSaved.InvokeAsync();
    }
}
