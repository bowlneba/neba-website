@namespace Neba.Website.Server.Tournaments.Schedule

<div class="neba-card tournament-past-card">
    <div class="tournament-past-card__grid">
        <div class="tournament-past-card__logo">
            <img src="@Tournament.DisplayLogoSrc"
                 alt="@Tournament.Name logo" class="tournament-past-card__logo-img" />
        </div>

        <div class="tournament-past-card__content">
            <div class="tournament-past-card__eyebrow">
                @if (Tournament.HasSponsor)
                {
                    <span class="tournament-past-card__sponsor">@Tournament.Sponsor</span>
                    <span aria-hidden="true">·</span>
                }
                <time>@Tournament.FormatDateRange()</time>
                @if (Tournament.IsTruncated || Tournament.IsCancelled)
                {
                    <span aria-hidden="true">·</span>
                    <span class="tournament-past-card__status-pill tournament-past-card__status-pill--@(Tournament.IsTruncated ? "truncated" : "cancelled")">
                        <span class="material-symbols-outlined" aria-hidden="true">@(Tournament.IsTruncated ? "warning" : "block")</span>
                        @Tournament.Status
                    </span>
                }
            </div>

            <h3 class="tournament-past-card__title">
                <a href="/tournaments/@Tournament.Id">@Tournament.Name</a>
            </h3>

            @if (Tournament.HasHost)
            {
                <p class="tournament-past-card__host">
                    <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                    @Tournament.DisplayLocation
                </p>
            }

            <div class="tournament-past-card__chips">
                <span class="tournament-past-card__chip">@Tournament.TournamentType</span>
            </div>
        </div>

        <div class="tournament-past-card__champion">
            @if (Tournament.HasWinners)
            {
                <div class="tournament-past-card__champion-pill">
                    <span class="material-symbols-outlined" aria-hidden="true">emoji_events</span>
                    <span class="tournament-past-card__champion-name">@string.Join(" / ", Tournament.Winners)</span>
                </div>
                @if (Tournament.IsTruncated)
                {
                    <p class="tournament-past-card__status-note">Finals cancelled — not a title win</p>
                }
            }
            else
            {
                <p class="tournament-past-card__results-pending">
                    @(Tournament.IsCancelled ? "No official results — event cancelled" : "Results pending")
                </p>
            }
            <a href="/tournaments/@Tournament.Id"
               class="neba-link tournament-past-card__results-link">
                View results →
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter][EditorRequired]
    public SeasonTournamentViewModel Tournament { get; set; } = default!;
}
