@using ErrorOr
@using Neba.Website.Server.Documents

@inject IRulesSectionService RulesSectionService
@inject ILogger<TournamentRulesLink> Logger

@if (_anchor is not null)
{
    <button type="button" class="td-rules-link" aria-haspopup="dialog" @onclick="OpenAsync">
        <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
        @(TournamentType + " rules")
    </button>

    <DocumentSectionSlideover IsOpen="@_isOpen"
                              OnClose="@Close"
                              Title="@(TournamentType + " rules")"
                              FullDocumentHref="@_anchor.Href"
                              Content="@_content"
                              IsLoading="@_isLoading"
                              ErrorMessage="@_errorMessage"
                              LoadingText="Loading rules..."
                              CloseLabel="Close rules"
                              LastUpdated="@_lastUpdated" />
}

@code {
    private TournamentRulesAnchor? _anchor;
    private bool _isOpen;
    private bool _isLoading;
    private bool _loaded;
    private MarkupString? _content;
    private string? _errorMessage;
    private DateTimeOffset? _lastUpdated;

    [Parameter, EditorRequired]
    public string TournamentType { get; set; } = default!;

    protected override void OnParametersSet()
        => _anchor = TournamentRulesAnchors.TryGet(TournamentType, out var anchor) ? anchor : null;

    private void Close() => _isOpen = false;

    private async Task OpenAsync()
    {
        _isOpen = true;

        if (_loaded || _isLoading || _anchor is null)
        {
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await RulesSectionService.GetSectionAsync(_anchor);

            if (result.IsError)
            {
                _errorMessage = result.FirstError.Type == ErrorType.NotFound
                    ? "We couldn't find this section. Open the full rules page instead."
                    : "We couldn't load the rules. Open the full rules page instead.";
            }
            else
            {
                _content = new MarkupString(result.Value.Html);
                _lastUpdated = result.Value.LastUpdated;
                _loaded = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[TournamentRulesLink] Failed to load the rules section for {TournamentType}.", TournamentType);
            _errorMessage = "We couldn't load the rules. Open the full rules page instead.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
