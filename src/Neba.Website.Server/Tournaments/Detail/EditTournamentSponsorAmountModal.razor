@using System.ComponentModel.DataAnnotations
@using ErrorOr
@using Neba.Api.Contracts.Tournaments.EditTournamentSponsorAmount

<DirtyFormGuard IsDirty="@(IsOpen && _isDirty)" />

<ConfirmActionModal IsOpen="@_isCancelConfirmOpen"
                     Title="Discard unsaved changes?"
                     Message="You have unsaved changes. If you close this dialog now, they will be lost."
                     ConfirmLabel="Discard"
                     CancelLabel="Keep Editing"
                     OnConfirm="ConfirmCancelAsync"
                     OnCancel="@(() => _isCancelConfirmOpen = false)" />

<NebaModal IsOpen="@IsOpen" OnClose="@HandleCancelRequestedAsync" Title="Edit Added Money" MaxWidth="440px" CompactSize="true">
    <ChildContent>
        @if (_errorMessage is not null)
        {
            <NebaAlert Severity="NotifySeverity.Error" Title="Couldn't Update Amount" Message="@_errorMessage"
                       Dismissible="true" OnDismiss="@(() => _errorMessage = null)" />
        }

        <div class="form-field">
            <FormLabel TargetId="sponsor-edit-amount" For="@(() => _model.SponsorshipAmount)">Added money from @Sponsor?.Name</FormLabel>
            <div class="mts-currency-input">
                <span class="mts-currency-input__prefix" aria-hidden="true">$</span>
                <input id="sponsor-edit-amount" class="neba-input mts-currency-input__field" type="number" min="0" max="99999.99" step="0.01" @bind="_model.SponsorshipAmount" @bind:event="oninput" @bind:after="MarkDirty" />
            </div>
        </div>
    </ChildContent>
    <FooterContent>
        <div class="mts-modal-actions">
            <button type="button" class="neba-btn neba-btn-secondary" @onclick="HandleCancelRequestedAsync" disabled="@_isSubmitting">Cancel</button>
            <button type="button" class="neba-btn neba-btn-primary" @onclick="SubmitAsync" disabled="@(_isSubmitting || !CanSave)">
                @(_isSubmitting ? "Saving..." : "Save")
            </button>
        </div>
    </FooterContent>
</NebaModal>

@code {
    [Parameter, EditorRequired]
    public bool IsOpen { get; set; }

    /// <summary>
    /// The sponsor whose amount is being edited. Null while the modal is closed.
    /// </summary>
    [Parameter]
    public TournamentDetailSponsorViewModel? Sponsor { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSaved { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Performs the actual "edit sponsor amount" API call, given the sponsor's id and the new input.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<string, EditTournamentSponsorAmountInput, CancellationToken, Task<ErrorOr<Success>>> OnSubmitRequestedAsync { get; set; } = default!;

    private EditAmountFormModel _model = new();
    private string? _loadedSponsorId;
    private bool _isSubmitting;
    private bool _isDirty;
    private bool _isCancelConfirmOpen;
    private string? _errorMessage;

    protected override void OnParametersSet()
    {
        if (IsOpen && Sponsor is not null && Sponsor.SponsorId != _loadedSponsorId)
        {
            _loadedSponsorId = Sponsor.SponsorId;
            _model = new EditAmountFormModel { SponsorshipAmount = Sponsor.SponsorshipAmount };
            _isDirty = false;
            _errorMessage = null;
        }
        else if (!IsOpen)
        {
            _loadedSponsorId = null;
        }
    }

    private const decimal MaxAmount = 99_999.99m;

    private bool CanSave
        => _model.SponsorshipAmount is >= 0 and <= MaxAmount
           && _model.SponsorshipAmount != Sponsor?.SponsorshipAmount;

    private void MarkDirty()
        => _isDirty = true;

    private Task HandleCancelRequestedAsync()
    {
        if (_isDirty)
        {
            _isCancelConfirmOpen = true;
            return Task.CompletedTask;
        }

        return CloseAsync();
    }

    private Task ConfirmCancelAsync()
    {
        _isCancelConfirmOpen = false;
        return CloseAsync();
    }

    private Task CloseAsync()
    {
        _isDirty = false;
        _errorMessage = null;
        return OnClose.InvokeAsync();
    }

    private async Task SubmitAsync()
    {
        if (Sponsor is null || !CanSave)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var input = new EditTournamentSponsorAmountInput { SponsorshipAmount = _model.SponsorshipAmount!.Value };

        var result = await OnSubmitRequestedAsync(Sponsor.SponsorId, input, CancellationToken.None);

        _isSubmitting = false;

        if (result.IsError)
        {
            _errorMessage = result.FirstError.Description;
            return;
        }

        _isDirty = false;

        await OnSaved.InvokeAsync();
    }

    private sealed class EditAmountFormModel
    {
        [Required]
        public decimal? SponsorshipAmount { get; set; }
    }
}
