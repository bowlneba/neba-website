@using Neba.Api.Contracts.ReferenceData

<section class="neba-space-y-4">
    <h2 class="create-sponsor-section-title">Phone Numbers</h2>

    @if (PhoneNumbers.Count > 0)
    {
        <ul class="create-sponsor-phone-list">
            @foreach (var phoneNumber in PhoneNumbers)
            {
                <li class="create-sponsor-phone-row">
                    <select class="neba-select create-sponsor-phone-type" value="@phoneNumber.PhoneNumberType" @onchange="@(e => HandleTypeChangedAsync(phoneNumber, e))">
                        @foreach (var phoneType in PhoneNumberTypes)
                        {
                            <option value="@phoneType.Code">@phoneType.Name</option>
                        }
                    </select>
                    <input class="neba-input create-sponsor-phone-number" value="@phoneNumber.PhoneNumber"
                           @oninput="@(e => HandleNumberChangedAsync(phoneNumber, e))"
                           placeholder="Phone number" />
                    <input class="neba-input create-sponsor-phone-extension" value="@phoneNumber.Extension"
                           @oninput="@(e => HandleExtensionChangedAsync(phoneNumber, e))"
                           placeholder="Ext." />
                    <button type="button" class="neba-btn neba-btn-danger create-sponsor-phone-remove"
                            aria-label="@RemoveLabel(phoneNumber)" @onclick="@(() => RemoveAsync(phoneNumber))">Remove</button>
                </li>
            }
        </ul>
    }

    <button type="button" class="neba-btn neba-btn-secondary" @onclick="AddAsync">Add Phone Number</button>
</section>

@code {
    [Parameter, EditorRequired]
    public List<TrackedPhoneNumber> PhoneNumbers { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyCollection<PhoneNumberTypeResponse> PhoneNumberTypes { get; set; } = [];

    [Parameter, EditorRequired]
    public EventCallback OnChanged { get; set; }

    private Task AddAsync()
    {
        PhoneNumbers.Add(new TrackedPhoneNumber());
        return OnChanged.InvokeAsync();
    }

    private Task RemoveAsync(TrackedPhoneNumber phoneNumber)
    {
        PhoneNumbers.Remove(phoneNumber);
        return OnChanged.InvokeAsync();
    }

    private static string RemoveLabel(TrackedPhoneNumber phoneNumber)
        => string.IsNullOrWhiteSpace(phoneNumber.PhoneNumber)
            ? "Remove phone number"
            : "Remove phone number " + phoneNumber.PhoneNumber;

    private Task HandleTypeChangedAsync(TrackedPhoneNumber phoneNumber, ChangeEventArgs e)
    {
        phoneNumber.PhoneNumberType = e.Value?.ToString() ?? "H";
        return OnChanged.InvokeAsync();
    }

    private Task HandleNumberChangedAsync(TrackedPhoneNumber phoneNumber, ChangeEventArgs e)
    {
        phoneNumber.PhoneNumber = e.Value?.ToString() ?? string.Empty;
        return OnChanged.InvokeAsync();
    }

    private Task HandleExtensionChangedAsync(TrackedPhoneNumber phoneNumber, ChangeEventArgs e)
    {
        phoneNumber.Extension = e.Value?.ToString();
        return OnChanged.InvokeAsync();
    }
}
