@preservewhitespace false
@page "/sponsors/{Slug}"
@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Sponsors
@using Neba.Website.Server.Services
@using Neba.Website.Server.Sponsors
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject ApiExecutor ApiExecutor
@inject ISponsorsApi SponsorsApi
@inject NavigationManager Navigation

<PageTitle>@(_model?.Name is not null ? _model.Name + " - BowlNEBA" : "Sponsor - BowlNEBA")</PageTitle>

@if (_isLoading)
{
    <div class="sponsor-detail-loading">
        <div class="neba-spinner"></div>
    </div>
}
else
{
    <main class="neba-content-wrapper sponsor-detail">

        <header class="sponsor-detail__header">
            <div class="sponsor-detail__logo-wrap">
                @if (_model?.LogoUrl is not null)
                {
                    <img src="@_model.LogoUrl" alt="@_model.Name logo" class="sponsor-detail__logo-img" />
                }
                else
                {
                    <div class="sponsor-detail__logo-placeholder">
                        <span class="material-symbols-outlined">business</span>
                    </div>
                }
            </div>

            <div class="sponsor-detail__header-body">
                <div class="sponsor-detail__badges">
                    <span class="sponsor-detail__badge sponsor-detail__badge--tier">@_model?.TierName</span>
                    @if (_model?.CategoryName is not null)
                    {
                        <span class="sponsor-detail__badge sponsor-detail__badge--category">@_model.CategoryName</span>
                    }
                    <AuthorizeView Policy="@Permissions.CanManageSponsorsPolicyName">
                        <Authorized>
                            @if (_model?.IsCurrentSponsor == true)
                            {
                                <span class="sponsor-detail__badge sponsor-detail__badge--status-active">Active</span>
                            }
                            else
                            {
                                <span class="sponsor-detail__badge sponsor-detail__badge--status-inactive">Inactive</span>
                            }
                        </Authorized>
                    </AuthorizeView>
                </div>

                <h1 class="sponsor-detail__title">@_model?.Name</h1>

                @if (_model?.Tagline is not null)
                {
                    <p class="sponsor-detail__tagline">@_model.Tagline</p>
                }

                <div class="flex flex-wrap gap-3">
                    @if (_model?.WebsiteUrl is not null)
                    {
                        <a href="@_model.WebsiteUrl" target="_blank" rel="noopener noreferrer"
                           class="neba-btn neba-btn-primary sponsor-detail__website-btn">
                            Visit Website
                            <span class="material-symbols-outlined">open_in_new</span>
                        </a>
                    }
                    <AuthorizeView Policy="@Permissions.EditSponsor.PolicyName">
                        <Authorized>
                            <a href="/sponsors/@Slug/edit" class="neba-btn neba-btn-secondary">
                                <span class="material-symbols-outlined">edit</span>
                                Edit Sponsor
                            </a>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <div class="sponsor-detail__body @(_model?.HasAnyContactInfo == true ? "" : "sponsor-detail__body--single-col")">

            <div class="sponsor-detail__col-main">

                @if (_model?.AboutText is not null)
                {
                    <section class="sponsor-detail__about">
                        <div class="sponsor-detail__section-heading">
                            <span class="sponsor-detail__step-num" aria-hidden="true">01</span>
                            <h2>About our Partner</h2>
                        </div>
                        <div class="neba-card sponsor-detail__about-card">
                            <p>@_model.AboutText</p>
                        </div>
                    </section>
                }

                @if (_model?.HasTournamentsSponsored == true)
                {
                    <section class="sponsor-detail__tournaments">
                        <div class="sponsor-detail__section-heading">
                            <span class="sponsor-detail__step-num" aria-hidden="true">02</span>
                            <h2>Tournaments Sponsored</h2>
                        </div>
                        <ul class="sponsor-detail__tournament-list">
                            @foreach (var tournament in _model.TournamentsSponsored)
                            {
                                <li class="sponsor-detail__tournament-list__item">
                                    <a href="/tournaments/@tournament.TournamentId" class="neba-link sponsor-detail__tournament-list__link">
                                        @tournament.Name
                                    </a>
                                    @if (tournament.TitleSponsor)
                                    {
                                        <span class="sponsor-detail__badge sponsor-detail__badge--title-sponsor">Title Sponsor</span>
                                    }
                                    <span class="sponsor-detail__tournament-list__dates">
                                        @FormatTournamentDateRange(tournament.StartDate, tournament.EndDate)
                                    </span>
                                </li>
                            }
                        </ul>
                    </section>
                }

                <AuthorizeView Policy="@Permissions.EditSponsor.PolicyName">
                    <Authorized>
                        @if (_model?.LiveReadText is not null || _model?.PromotionalNotes is not null)
                        {
                            <section class="sponsor-detail__promo">
                                <div class="sponsor-detail__promo-header">
                                    <span class="material-symbols-outlined">admin_panel_settings</span>
                                    <h3 class="sponsor-detail__promo-title">Staff-Only Info</h3>
                                </div>
                                @if (_model.LiveReadText is not null)
                                {
                                    <div class="sponsor-detail__promo-block">
                                        <p class="sponsor-detail__promo-label">Live Read Text</p>
                                        <p class="sponsor-detail__live-read">@_model.LiveReadText</p>
                                    </div>
                                }
                                @if (_model.PromotionalNotes is not null)
                                {
                                    <div class="sponsor-detail__promo-block">
                                        <p class="sponsor-detail__promo-label">Promotional Notes</p>
                                        <p class="sponsor-detail__live-read">@_model.PromotionalNotes</p>
                                    </div>
                                }
                            </section>
                        }
                    </Authorized>
                </AuthorizeView>

            </div>

            @if (_model?.HasAnyContactInfo == true)
            {
            <div class="sponsor-detail__col-aside">

                <section class="neba-card sponsor-detail__contact-card">

                    @if (_model.HasAddress)
                    {
                        <div class="sponsor-detail__contact-section">
                            <h3 class="sponsor-detail__contact-label">Business Location</h3>
                            <div class="sponsor-detail__contact-row">
                                <span class="material-symbols-outlined">location_on</span>
                                <address class="sponsor-detail__address">
                                    @if (_model.BusinessStreet is not null)
                                    {
                                        <span>@_model.BusinessStreet</span>
                                    }
                                    @if (_model.BusinessUnit is not null)
                                    {
                                        <span>@_model.BusinessUnit</span>
                                    }
                                    @if (_model.BusinessCity is not null || _model.BusinessState is not null)
                                    {
                                        <span>@_model.BusinessCity, @_model.BusinessState @_model.BusinessPostalCode</span>
                                    }
                                    @if (_model.BusinessCountry is not null)
                                    {
                                        <span>@_model.BusinessCountry</span>
                                    }
                                </address>
                            </div>
                        </div>
                    }

                    @if (_model.HasContactChannels)
                    {
                        <div class="sponsor-detail__contact-section">
                            <h3 class="sponsor-detail__contact-label">Contact Channels</h3>
                            <ul class="sponsor-detail__channel-list">
                                @if (_model.ContactEmail is not null)
                                {
                                    <li class="sponsor-detail__contact-row">
                                        <span class="material-symbols-outlined">mail</span>
                                        <a href="mailto:@_model.ContactEmail"
                                           class="sponsor-detail__email-link">@_model.ContactEmail</a>
                                    </li>
                                }
                                @foreach (var phone in _model.PhoneNumbers)
                                {
                                    <li class="sponsor-detail__contact-row">
                                        <span class="material-symbols-outlined">call</span>
                                        <div>
                                            <p class="sponsor-detail__phone-number">@FormatPhoneNumber(phone.PhoneNumber)</p>
                                            <p class="sponsor-detail__phone-label">@phone.PhoneNumberType</p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (_model.HasSocialMedia)
                    {
                        <div class="sponsor-detail__contact-section">
                            <h3 class="sponsor-detail__contact-label">Social Media</h3>
                            <div class="sponsor-detail__social-row">
                                @if (_model.FacebookUrl is not null)
                                {
                                    <a href="@_model.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook"
                                       class="sponsor-detail__social-btn">
                                        <NebaSocialIcon Network="SocialNetwork.Facebook" />
                                    </a>
                                }
                                @if (_model.InstagramUrl is not null)
                                {
                                    <a href="@_model.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                                       class="sponsor-detail__social-btn">
                                        <NebaSocialIcon Network="SocialNetwork.Instagram" />
                                    </a>
                                }
                            </div>
                        </div>
                    }

                </section>

                <AuthorizeView Policy="@Permissions.EditSponsor.PolicyName">
                    <Authorized>
                        @if (_model?.Contact is not null)
                        {
                            <section class="neba-card sponsor-detail__internal-contact">
                                <div class="sponsor-detail__internal-header">
                                    <span class="material-symbols-outlined">badge</span>
                                    <h3>Internal Contact</h3>
                                </div>
                                <p class="sponsor-detail__internal-name">@_model.Contact.Name</p>
                                <div class="sponsor-detail__internal-details">
                                    <div class="sponsor-detail__internal-row">
                                        <span class="material-symbols-outlined">mail</span>
                                        <a href="mailto:@_model.Contact.Email" style="color:inherit;">@_model.Contact.Email</a>
                                    </div>
                                    <div class="sponsor-detail__internal-row">
                                        <span class="material-symbols-outlined">call</span>
                                        <span>@FormatPhoneNumber(_model.Contact.Phone.PhoneNumber)</span>
                                        <span class="sponsor-detail__internal-phone-type">@_model.Contact.Phone.PhoneNumberType</span>
                                    </div>
                                </div>
                            </section>
                        }
                    </Authorized>
                </AuthorizeView>

            </div>
            }
        </div>

        <footer class="sponsor-detail__footer">
            <a href="/sponsors" class="sponsor-detail__back-link">
                <span class="material-symbols-outlined">arrow_back</span>
                Back to Sponsor Directory
            </a>
        </footer>

    </main>
}

@code {
    [Parameter] public string Slug { get; set; } = default!;

    private SponsorDetailViewModel? _model;
    private bool _isLoading = true;

    private static string FormatPhoneNumber(string phoneNumber)
    {
        var digits = new string(phoneNumber.Where(char.IsDigit).ToArray());
        return digits.Length == 10
            ? $"({digits[..3]}) {digits[3..6]}-{digits[6..]}"
            : phoneNumber;
    }

    private static string FormatTournamentDateRange(DateOnly startDate, DateOnly endDate) =>
        startDate == endDate
            ? startDate.ToString("MMM d, yyyy")
            : startDate.ToString("MMM d") + " – " + endDate.ToString("MMM d, yyyy");

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiExecutor.ExecuteAsync(
            "Sponsors",
            "GetSponsorDetail",
            ct => SponsorsApi.GetSponsorBySlugAsync(Slug, ct));

        if (result.IsError)
        {
            // The server already treats an inactive sponsor as not-found for callers without the
            // Sponsors management permission (see GetSponsorDetailQueryHandler) — an authorized staff
            // member who just created/manages a non-current sponsor still gets the real response.
            Navigation.NavigateTo("/not-found", replace: true);
            return;
        }

        _model = result.Value.ToViewModel();
        _isLoading = false;
    }
}
