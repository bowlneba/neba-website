@page "/test-component"
@rendermode InteractiveServer
@using ErrorOr
@using Neba.Api.Contracts.News
@using Neba.Api.Contracts.Uploads
@using Neba.Website.Server.Services
@using Refit

@inject INewsApi NewsApi
@inject ApiExecutor ApiExecutor

<PageTitle>Component Test - BowlNEBA</PageTitle>

<div class="max-w-5xl mx-auto py-8 px-4 space-y-10">
    <div>
        <h1 class="text-2xl font-bold mb-2">RichTextEditor Test Page</h1>
        <p class="text-sm text-gray-600">
            Temporary page for manually verifying <code>RichTextEditor.razor</code>. Delete this file (and its route)
            once verification is complete.
        </p>
    </div>

    <section class="space-y-3 border rounded-lg p-4">
        <h2 class="text-lg font-semibold">Editor A — two-way binding + read-only toggle</h2>
        <p class="text-sm text-gray-600">
            Things to verify: typing updates the "Live bound Value" panel below as you type; toggling read-only
            disables editing without losing content; "Set from code" pushes new HTML into the editor without you
            typing it.
        </p>

        <div class="flex flex-wrap gap-2">
            <button class="neba-btn neba-btn-sm neba-btn-secondary" @onclick="ToggleReadOnlyA">
                @(_readOnlyA ? "Make Editable" : "Make Read-Only")
            </button>
            <button class="neba-btn neba-btn-sm neba-btn-secondary" @onclick="SetFromCodeA">
                Set From Code
            </button>
            <button class="neba-btn neba-btn-sm neba-btn-secondary" @onclick="ClearA">
                Clear
            </button>
        </div>

        <RichTextEditor @bind-Value="_contentA"
                         ReadOnly="_readOnlyA"
                         Placeholder="Write your article..."
                         CssClass="border rounded" />

        <div class="text-xs">
            <div class="font-semibold mb-1">Live bound Value (raw HTML):</div>
            <pre class="bg-gray-100 p-2 rounded overflow-x-auto">@_contentA</pre>
        </div>
    </section>

    <section class="space-y-3 border rounded-lg p-4">
        <h2 class="text-lg font-semibold">Editor B — independent second instance</h2>
        <p class="text-sm text-gray-600">
            Things to verify: this editor's content is completely independent of Editor A (proves the JS module's
            per-container instance map isn't leaking state between multiple editors on the same page).
        </p>

        <RichTextEditor @bind-Value="_contentB" CssClass="border rounded" />

        <div class="text-xs">
            <div class="font-semibold mb-1">Live bound Value (raw HTML):</div>
            <pre class="bg-gray-100 p-2 rounded overflow-x-auto">@_contentB</pre>
        </div>
    </section>

    <section class="space-y-3 border rounded-lg p-4">
        <h2 class="text-lg font-semibold">Editor C — mount/unmount (dispose check)</h2>
        <p class="text-sm text-gray-600">
            Things to verify: toggling this off and back on should not throw, leak console errors, or leave a
            duplicate toolbar behind (proves <code>DisposeAsync</code> tears down cleanly).
        </p>

        <button class="neba-btn neba-btn-sm neba-btn-secondary" @onclick="ToggleMounted">
            @(_showEditorC ? "Unmount" : "Mount")
        </button>

        @if (_showEditorC)
        {
            <RichTextEditor @bind-Value="_contentC" CssClass="border rounded" />
        }
    </section>

    <section class="space-y-3 border rounded-lg p-4">
        <h2 class="text-lg font-semibold">FileUpload D — article header image (single file)</h2>
        <p class="text-sm text-gray-600">
            Things to verify: drag-and-drop and click-to-browse both work; selecting an image shows a
            thumbnail preview immediately; the progress bar advances during upload; selecting a second
            file replaces the first (MaxFiles=1); the result hits the real
            <code>UploadArticleHeaderImageEndpoint</code> (requires the API + Azurite emulator running).
        </p>

        <FileUpload MaxFiles="1"
                    Accept="image/*"
                    Label="Upload header image"
                    OnUploadRequestedAsync="UploadHeaderImageAsync"
                    OnFileUploaded="HandleHeaderImageUploaded"
                    OnFileRemoved="HandleHeaderImageRemoved" />

        @if (_headerImageResult is not null)
        {
            <div class="text-xs">
                <div class="font-semibold mb-1">Last uploaded header image:</div>
                <pre class="bg-gray-100 p-2 rounded overflow-x-auto">@_headerImageResult</pre>
            </div>
        }
    </section>

    <section class="space-y-3 border rounded-lg p-4">
        <h2 class="text-lg font-semibold">FileUpload E — article attachments (multi file)</h2>
        <p class="text-sm text-gray-600">
            Things to verify: multiple files can be selected/dropped at once, each uploads and tracks
            progress independently; non-image files show a generic icon instead of a thumbnail; removing
            a file mid-upload cancels its request; results hit the real
            <code>UploadArticleAttachmentEndpoint</code>.
        </p>

        <FileUpload MaxFiles="5"
                    Accept="image/*,.pdf,.doc,.docx"
                    Label="Upload attachments"
                    OnUploadRequestedAsync="UploadAttachmentAsync"
                    OnFileUploaded="HandleAttachmentUploaded"
                    OnFileRemoved="HandleAttachmentRemoved" />

        @if (_attachmentResults.Count > 0)
        {
            <div class="text-xs">
                <div class="font-semibold mb-1">Uploaded attachments:</div>
                @foreach (var attachment in _attachmentResults)
                {
                    <pre class="bg-gray-100 p-2 rounded overflow-x-auto">@FormatAttachment(attachment)</pre>
                }
            </div>
        }
    </section>
</div>

@code {
    private string _contentA = "<p>Hello, this is <strong>Editor A</strong>.</p>";
    private string _contentB = "<p>Hello, this is <em>Editor B</em>.</p>";
    private string _contentC = "<p>Mount/unmount me.</p>";
    private bool _readOnlyA;
    private bool _showEditorC = true;

    private void ToggleReadOnlyA() => _readOnlyA = !_readOnlyA;

    private void SetFromCodeA() => _contentA = "<p>Replaced <u>from code</u> at " + DateTime.Now.ToLongTimeString() + ".</p>";

    private void ClearA() => _contentA = string.Empty;

    private void ToggleMounted() => _showEditorC = !_showEditorC;

    private string? _headerImageResult;
    private readonly List<UploadedFileResponse> _attachmentResults = [];

    private async Task<ErrorOr<UploadedFileResponse>> UploadHeaderImageAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleHeaderImage",
            c => NewsApi.UploadArticleHeaderImageAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private void HandleHeaderImageUploaded(UploadedFileResponse response)
        => _headerImageResult = $"{response.Container}/{response.Path} ({response.ContentType}, {response.SizeInBytes} bytes)";

    private void HandleHeaderImageRemoved(UploadedFileResponse response)
        => _headerImageResult = null;

    private async Task<ErrorOr<UploadedFileResponse>> UploadAttachmentAsync(
        Stream stream, string fileName, string contentType, IProgress<int> progress, CancellationToken ct)
        => await ApiExecutor.ExecuteAsync(
            "News",
            "UploadArticleAttachment",
            c => NewsApi.UploadArticleAttachmentAsync(new StreamPart(stream, fileName, contentType), c),
            ct);

    private void HandleAttachmentUploaded(UploadedFileResponse response)
        => _attachmentResults.Add(response);

    private void HandleAttachmentRemoved(UploadedFileResponse response)
        => _attachmentResults.RemoveAll(a => a.Path == response.Path);

    private static string FormatAttachment(UploadedFileResponse response)
        => $"{response.Container}/{response.Path} ({response.ContentType}, {response.SizeInBytes} bytes)";
}
