@{
    RenderFragment portrait = @<text>
        @if (PhotoUri is not null)
        {
            <img class="inductee-photo__img" src="@PhotoUri.AbsoluteUri" alt="" style="@ImageStyle" loading="lazy" />
        }
        else
        {
            @GetInitials(BowlerName)
        }
    </text>;
}

<div class="avatar-wrap">
    @if (OnOpen.HasDelegate)
    {
        <button type="button"
                class="@(PhotoClass + " inductee-photo--button")"
                tabindex="-1"
                aria-hidden="true"
                @onclick="OnOpen">
            @portrait
        </button>
    }
    else
    {
        <div class="@PhotoClass">
            @portrait
        </div>
    }

    @if (OnEdit.HasDelegate)
    {
        <HallOfFamePhotoEditButton BowlerName="@BowlerName" OnClick="OnEdit" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string BowlerName { get; set; } = string.Empty;

    [Parameter]
    public Uri? PhotoUri { get; set; }

    [Parameter]
    public int? FocalX { get; set; }

    [Parameter]
    public int? FocalY { get; set; }

    [Parameter]
    public int? Zoom { get; set; }

    /// <summary>
    /// Draws a gold ring around the portrait, for use on a dark background.
    /// </summary>
    [Parameter]
    public bool Ringed { get; set; }

    /// <summary>
    /// When set, the avatar shows the edit button (visible only to users with the permission).
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    /// <summary>
    /// When set, the portrait is a mouse-only button that raises this callback (opens the inductee's profile). It is skipped by keyboard and screen readers; the name beside it is the accessible control.
    /// </summary>
    [Parameter]
    public EventCallback OnOpen { get; set; }

    private string PhotoClass
        => Ringed ? "inductee-photo inductee-photo--ringed" : "inductee-photo";

    private string ImageStyle
        => new FocalPoint(FocalX ?? FocalPoint.Default.X, FocalY ?? FocalPoint.Default.Y, Zoom ?? FocalPoint.Default.Zoom)
            .ToImageStyle();

    internal static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
        {
            return string.Concat(parts[0][0], parts[^1][0]);
        }

        return parts.Length > 0 ? parts[0][0].ToString() : "?";
    }
}
