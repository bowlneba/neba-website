@typeparam TValue
@typeparam TItem
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div id="@_containerId" class="neba-autocomplete">
    <div class="neba-autocomplete-control">
        <input id="@Id"
               type="text"
               class="neba-input neba-autocomplete-input"
               placeholder="@(_isOpen ? Placeholder : EmptyLabel)"
               value="@(_isOpen ? _filterText : SelectedDisplayText)"
               disabled="@Disabled"
               autocomplete="off"
               role="combobox"
               aria-expanded="@(_isOpen ? "true" : "false")"
               aria-controls="@_listboxId"
               aria-autocomplete="list"
               @onfocus="HandleFocus"
               @oninput="HandleInput"
               @onkeydown="HandleKeyDownAsync" />

        @if (!Disabled && HasValue)
        {
            <button type="button" class="neba-autocomplete-clear" aria-label="Clear selection" @onclick="ClearAsync">
                <span aria-hidden="true">&times;</span>
            </button>
        }
    </div>

    @if (_isOpen)
    {
        <ul id="@_listboxId" class="neba-autocomplete-panel" role="listbox">
            @if (_filteredItems.Count == 0)
            {
                <li class="neba-autocomplete-empty">@NoResultsText</li>
            }
            else
            {
                @for (var i = 0; i < _filteredItems.Count; i++)
                {
                    var index = i;
                    var item = _filteredItems[i];
                    <li class="neba-autocomplete-option @(index == _highlightedIndex ? "highlighted" : "")"
                        role="option"
                        aria-selected="@(IsSelected(item) ? "true" : "false")"
                        @onclick="@(() => SelectAsync(item))">
                        @GetDisplayText(item)
                    </li>
                }
            }
        </ul>
    }
</div>

@code {
    private readonly string _containerId = $"neba-autocomplete-{Guid.NewGuid():N}";
    private string _listboxId = string.Empty;

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<NebaAutocomplete<TValue, TItem>>? _dotNetHelper;

    private bool _isOpen;
    private string _filterText = string.Empty;
    private int _highlightedIndex;
    private List<TItem> _filteredItems = [];

    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public Func<TItem, string> DisplayText { get; set; } = default!;

    [Parameter, EditorRequired]
    public Func<TItem, TValue?> ItemValue { get; set; } = default!;

    [Parameter]
    public string Placeholder { get; set; } = "Type to search...";

    [Parameter]
    public string EmptyLabel { get; set; } = "Not yet assigned";

    [Parameter]
    public string NoResultsText { get; set; } = "No matches found";

    [Parameter]
    public bool Disabled { get; set; }

    private bool HasValue => !EqualityComparer<TValue>.Default.Equals(Value, default);

    private string SelectedDisplayText
    {
        get
        {
            if (!HasValue)
            {
                return string.Empty;
            }

            var selected = Items.FirstOrDefault(item => IsSelected(item));
            return selected is null ? string.Empty : GetDisplayText(selected);
        }
    }

    protected override void OnInitialized()
    {
        _listboxId = _containerId + "-listbox";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _dotNetHelper = DotNetObjectReference.Create(this);
        _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./Components/NebaAutocomplete.razor.js");
        await _jsModule.InvokeVoidAsync("initialize", _containerId, _dotNetHelper);
    }

    private string GetDisplayText(TItem item) => DisplayText(item);

    private bool IsSelected(TItem item)
        => HasValue && EqualityComparer<TValue>.Default.Equals(ItemValue(item), Value);

    private void HandleFocus()
    {
        if (Disabled)
        {
            return;
        }

        _isOpen = true;
        _filterText = string.Empty;
        UpdateFilteredItems();
    }

    private void HandleInput(ChangeEventArgs e)
    {
        _isOpen = true;
        _filterText = e.Value?.ToString() ?? string.Empty;
        UpdateFilteredItems();
    }

    private void UpdateFilteredItems()
    {
        _filteredItems = string.IsNullOrWhiteSpace(_filterText)
            ? Items.ToList()
            : Items.Where(item => GetDisplayText(item).Contains(_filterText, StringComparison.OrdinalIgnoreCase)).ToList();

        _highlightedIndex = 0;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (!_isOpen)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _highlightedIndex = Math.Min(_highlightedIndex + 1, _filteredItems.Count - 1);
                break;

            case "ArrowUp":
                _highlightedIndex = Math.Max(_highlightedIndex - 1, 0);
                break;

            case "Enter":
                if (_filteredItems.Count > 0 && _highlightedIndex < _filteredItems.Count)
                {
                    await SelectAsync(_filteredItems[_highlightedIndex]);
                }
                break;

            case "Escape":
            case "Tab":
                Close();
                break;
        }
    }

    private async Task SelectAsync(TItem item)
    {
        var value = ItemValue(item);
        Value = value;
        Close();
        await ValueChanged.InvokeAsync(value);
    }

    private async Task ClearAsync()
    {
        Value = default;
        _filterText = string.Empty;
        await ValueChanged.InvokeAsync(default);
    }

    private void Close()
    {
        _isOpen = false;
        _filterText = string.Empty;
    }

    /// <summary>Invoked by JS when a click lands outside the component's container.</summary>
    [JSInvokable]
    public void NotifyClickedOutside()
    {
        if (!_isOpen)
        {
            return;
        }

        Close();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("dispose", _containerId);
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up client-side.
            }

            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit already gone — nothing to clean up client-side.
            }
        }

        _dotNetHelper?.Dispose();
    }
}
