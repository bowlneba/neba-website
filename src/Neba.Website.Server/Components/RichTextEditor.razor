@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject ILogger<RichTextEditor> Logger

<div id="@ContainerId" class="@CssClass"></div>

@code {
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<RichTextEditor>? _dotNetHelper;
    private string? _lastKnownValue;
    private bool _lastKnownReadOnly;

    private string ContainerId { get; } = $"neba-rte-{Guid.NewGuid():N}";

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./Components/RichTextEditor.razor.js");

            _dotNetHelper = DotNetObjectReference.Create(this);
            _lastKnownValue = Value;
            _lastKnownReadOnly = ReadOnly;

            await _jsModule.InvokeVoidAsync("initialize", ContainerId, _dotNetHelper, Value, ReadOnly, Placeholder);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_jsModule is null)
        {
            return;
        }

        if (Value != _lastKnownValue)
        {
            _lastKnownValue = Value;
            await _jsModule.InvokeVoidAsync("setHtml", ContainerId, Value);
        }

        if (ReadOnly != _lastKnownReadOnly)
        {
            _lastKnownReadOnly = ReadOnly;
            await _jsModule.InvokeVoidAsync("setReadOnly", ContainerId, ReadOnly);
        }
    }

    /// <summary>
    /// Invoked by JS whenever the user edits the document (Quill's "text-change" event with source "user").
    /// </summary>
    [JSInvokable]
    public async Task NotifyContentChanged(string html)
    {
        _lastKnownValue = html;
        Value = html;

        await ValueChanged.InvokeAsync(html);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("dispose", ContainerId);
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogInformation(ex, "[RichTextEditor] JS cleanup skipped because the circuit disconnected.");
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "[RichTextEditor] Error during JS cleanup.");
            }

            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogInformation(ex, "[RichTextEditor] JS module disposal skipped because the circuit disconnected.");
            }
            catch (JSException ex)
            {
                Logger.LogWarning(ex, "[RichTextEditor] Failed to dispose JS module.");
            }
        }

        _dotNetHelper?.Dispose();
    }
}
