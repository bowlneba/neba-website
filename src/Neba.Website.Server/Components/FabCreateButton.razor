<a href="@Href" class="neba-fab" aria-label="@Label" title="@Label">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
        <path d="M12 5v14M5 12h14" />
    </svg>
</a>

@code {
    /// <summary>
    /// The URL to navigate to when the button is activated (e.g. a "create new" route).
    /// </summary>
    [Parameter, EditorRequired]
    public string Href { get; set; } = default!;

    /// <summary>
    /// Accessible label announced to screen readers and shown as a hover tooltip. Should name the
    /// action, e.g. "Create Article".
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = default!;
}
