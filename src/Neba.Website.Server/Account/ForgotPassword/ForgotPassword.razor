@page "/account/forgot-password"

@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Security.ForgotPassword
@using Neba.Website.Server.Services
@rendermode InteractiveServer

@inject ApiExecutor ApiExecutor
@inject ISecurityApi SecurityApi

<PageTitle>Forgot Password - BowlNEBA</PageTitle>

<div class="flex items-center justify-center min-h-[60vh] px-4">
    <div class="w-full max-w-sm neba-space-y-4">

        @if (_hasError)
        {
            <NebaAlert Severity="NotifySeverity.Error" Message="We couldn't send your request. Please try again in a few minutes." Dismissible="false" />
        }

        <div class="neba-card">
            <div class="text-center mb-6">
                <img src="/images/neba-logo.png" alt="NEBA" class="h-12 mx-auto mb-3" style="display:block;margin:0 auto;" />
                <h1 class="text-xl font-bold text-[var(--neba-gray-900)] font-display">Forgot Your Password?</h1>
                @if (!_sent)
                {
                    <p class="text-sm text-[var(--neba-gray-500)] mt-2">
                        Enter your email and we'll send you a link to choose a new one.
                    </p>
                }
            </div>

            @if (_sent)
            {
                @* One fixed message for every email. Nothing on this page may depend on whether the account exists. *@
                <NebaAlert Severity="NotifySeverity.Success" Message="@SentMessage" Dismissible="false" />
                <div class="flex justify-center mt-4">
                    <a href="/account/login" class="text-sm text-[var(--neba-blue-700)] hover:underline" data-enhance-nav="false">Back to log in</a>
                </div>
            }
            else
            {
                <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" novalidate>
                    <DataAnnotationsValidator />
                    <div class="neba-space-y-4">
                        <div>
                            <label for="email" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Email</label>
                            <InputText id="email" @bind-Value="_model.Email" type="email" autocomplete="email"
                                       class="neba-input w-full" placeholder="user@bowlneba.com" aria-describedby="email-error" />
                            <NebaValidationMessage For="@(() => _model.Email)" Id="email-error" Class="block text-sm text-red-600 mt-1" />
                        </div>
                        <button type="submit" class="neba-btn neba-btn-primary w-full justify-center" disabled="@_isSubmitting">
                            @(_isSubmitting ? "Sending…" : "Send reset link")
                        </button>
                        <a href="/account/login" class="neba-btn neba-btn-secondary w-full justify-center" data-enhance-nav="false">Back to log in</a>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private const string SentMessage =
        "If an account exists for that email, we've sent a password reset link. The link expires in 1 hour.";

    private readonly ForgotPasswordFormModel _model = new();

    private bool _isSubmitting;
    private bool _sent;
    private bool _hasError;

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        _hasError = false;

        var result = await ApiExecutor.ExecuteAsync(
            "Security",
            "ForgotPassword",
            ct => SecurityApi.ForgotPasswordAsync(new ForgotPasswordRequest { Email = _model.Email.Trim() }, ct));

        _isSubmitting = false;

        // Anything but a clean 204 (network, 429, 5xx) shows the same generic error. The page never
        // repeats server text, so no response can tell a visitor whether the account exists.
        _sent = !result.IsError;
        _hasError = result.IsError;
    }
}
