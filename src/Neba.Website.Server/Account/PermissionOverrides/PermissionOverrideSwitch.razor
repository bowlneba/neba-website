@namespace Neba.Website.Server.Account.PermissionOverrides

<span class="override-switch">
    <span class="override-track" role="radiogroup" aria-label="@(Label + " override")" data-state="@StateKey(Value)">
        @foreach (var option in Options)
        {
            var optionId = _groupId + "-" + StateKey(option);
            var isDisabled = Disabled || DisabledStates.Contains(option);

            <input type="radio" id="@optionId" name="@_groupId" value="@StateKey(option)"
                   checked="@(Value == option)" disabled="@isDisabled"
                   @onchange="@(() => SelectAsync(option))" />
            <label for="@optionId" title="@(isDisabled && !Disabled ? DisabledReason : Text(option))">
                <span class="visually-hidden">@Text(option)</span>
                @if (option == PermissionOverrideState.Added)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                }
                else if (option == PermissionOverrideState.Removed)
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 12h12" /></svg>
                }
            </label>
        }
        <span class="override-thumb" aria-hidden="true"></span>
    </span>
    <span class="override-state-label" data-state="@StateKey(Value)">@Text(Value)</span>
</span>

@code {
    // Left to right, matching the mockups: Added, Default, Removed.
    private static readonly PermissionOverrideState[] Options =
        [PermissionOverrideState.Added, PermissionOverrideState.Default, PermissionOverrideState.Removed];

    private readonly string _groupId = "override-" + Guid.NewGuid().ToString("N");

    /// <summary>Accessible name: the permission this switch controls.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public PermissionOverrideState Value { get; set; }

    [Parameter]
    public EventCallback<PermissionOverrideState> ValueChanged { get; set; }

    /// <summary>Disables the whole switch (e.g. own account).</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Positions that can't be chosen, e.g. Added when the caller doesn't hold the permission.</summary>
    [Parameter]
    public IReadOnlySet<PermissionOverrideState> DisabledStates { get; set; } = new HashSet<PermissionOverrideState>();

    /// <summary>Tooltip for a position disabled through <see cref="DisabledStates"/>.</summary>
    [Parameter]
    public string DisabledReason { get; set; } = string.Empty;

    private Task SelectAsync(PermissionOverrideState state)
        => ValueChanged.InvokeAsync(state);

    private static string StateKey(PermissionOverrideState state)
        => state.ToString().ToLowerInvariant();

    private static string Text(PermissionOverrideState state)
        => state.ToString();
}
