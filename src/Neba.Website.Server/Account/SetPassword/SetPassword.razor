@page "/account/set-password"
@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Security.SetPasswordFromToken
@using Neba.Website.Server.Services
@using Refit
@rendermode InteractiveServer

@inject ApiExecutor ApiExecutor
@inject ISecurityApi SecurityApi
@inject NavigationManager NavigationManager

<PageTitle>Set Password - BowlNEBA</PageTitle>

<div class="flex items-center justify-center min-h-[60vh] px-4">
    <div class="w-full max-w-sm neba-space-y-4">

        @if (_errorMessage is not null)
        {
            <NebaAlert Severity="NotifySeverity.Error" Message="@_errorMessage" Dismissible="false" />
        }

        <div class="neba-card">
            <div class="text-center mb-6">
                <img src="/images/neba-logo.png" alt="NEBA" class="h-12 mx-auto mb-3" style="display:block;margin:0 auto;" />
                <h1 class="text-xl font-bold text-[var(--neba-gray-900)] font-display">@Heading</h1>
                <p class="text-sm text-[var(--neba-gray-500)] mt-2">@Subtext</p>
            </div>

            <form @onsubmit="HandleSubmitAsync">
                <div class="neba-space-y-4">
                    <PasswordFields Label="New Password"
                                     Password="@_password"
                                     PasswordChanged="@(value => _password = value)"
                                     ConfirmPassword="@_confirmPassword"
                                     ConfirmPasswordChanged="@(value => _confirmPassword = value)" />

                    <button type="submit" class="neba-btn neba-btn-primary w-full justify-center" disabled="@(_isSubmitting || !CanSubmit)">
                        @(_isSubmitting ? "Setting Password…" : "Set Password")
                    </button>
                </div>
            </form>

            @if (IsReset && _errorMessage is not null)
            {
                <div class="flex justify-center mt-4">
                    <a href="/account/forgot-password" class="text-sm text-[var(--neba-blue-700)] hover:underline" data-enhance-nav="false">Request a new link</a>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    private string? Reason { get; set; }

    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isSubmitting;
    private string? _errorMessage;

    // Missing or unknown means the old invite copy, so links emailed before this change look as they did.
    private bool IsReset => Reason == PasswordTokenPurpose.Reset;

    private bool HasKnownReason => Reason is PasswordTokenPurpose.Reset or PasswordTokenPurpose.Invite;

    private string Heading => IsReset ? "Choose a New Password" : "Set Your Password";

    private string Subtext => IsReset
        ? "Enter a new password for your BowlNEBA account."
        : "You've been invited to BowlNEBA — choose a password to activate your account.";

    private string InvalidLinkMessage => IsReset
        ? "This reset link is invalid or has expired."
        : "This invite link is invalid or has expired. Ask an admin to send a new one.";

    private bool CanSubmit => _password.Length > 0 && _password == _confirmPassword;

    private async Task HandleSubmitAsync()
    {
        if (!CanSubmit || UserId is null || Token is null)
        {
            _errorMessage = InvalidLinkMessage;
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        var result = await ApiExecutor.ExecuteAsync(
            "Security",
            "SetPasswordFromToken",
            ct => SecurityApi.SetPasswordFromTokenAsync(new SetPasswordFromTokenRequest
            {
                UserId = UserId,
                Token = Token,
                NewPassword = _password,
                Purpose = HasKnownReason ? Reason : null
            }, ct));

        _isSubmitting = false;

        if (result.IsError)
        {
            _errorMessage = InvalidLinkMessage;
            return;
        }

        NavigationManager.NavigateTo("/account/login?passwordSet=true", forceLoad: true);
    }
}
