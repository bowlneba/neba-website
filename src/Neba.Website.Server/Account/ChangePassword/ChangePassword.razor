@page "/account/change-password"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Neba.Api.Contracts.Security
@using Neba.Api.Contracts.Security.ChangePassword
@using Neba.Website.Server.Account.Session
@using Neba.Website.Server.Services
@attribute [Authorize]
@rendermode InteractiveServer

@inject ApiExecutor ApiExecutor
@inject ISecurityApi SecurityApi
@inject SessionTokenCache TokenCache
@inject ISessionCookieSync SessionCookieSync

<PageTitle>Change Password - BowlNEBA</PageTitle>

<DirtyFormGuard IsDirty="@_isDirty" />

<div class="flex items-center justify-center min-h-[60vh] px-4">
    <div class="w-full max-w-sm neba-space-y-4">

        @if (_outcome == ChangeOutcome.Changed)
        {
            <NebaAlert Severity="NotifySeverity.Success" Message="Your password was changed. Other devices will be signed out shortly." Dismissible="false" />
        }
        else if (_outcome == ChangeOutcome.ChangedSessionNotSaved)
        {
            <NebaAlert Severity="NotifySeverity.Warning" Message="Your password was changed, but we couldn't refresh your session. You'll be asked to log in again." Dismissible="false" />
            <div class="flex justify-center">
                <a href="/account/logout" class="text-sm text-[var(--neba-blue-700)] hover:underline" data-enhance-nav="false">Log in again</a>
            </div>
        }

        @if (_errorMessage is not null)
        {
            <NebaAlert Severity="NotifySeverity.Error" Message="@_errorMessage" Dismissible="false" />
        }

        <div class="neba-card">
            <div class="text-center mb-6">
                <h1 class="text-xl font-bold text-[var(--neba-gray-900)] font-display">Change Password</h1>
                @if (_email is not null)
                {
                    <p class="text-sm text-[var(--neba-gray-500)] mt-2">Choose a new password for @_email.</p>
                }
            </div>

            <form @onsubmit="HandleSubmitAsync">
                <div class="neba-space-y-4">
                    <div>
                        <label for="current-password" class="block text-sm font-medium text-[var(--neba-gray-700)] mb-1">Current Password</label>
                        <input id="current-password" type="password" class="neba-input w-full" autocomplete="current-password"
                               value="@_currentPassword" @oninput="HandleCurrentPasswordInput" />
                    </div>

                    <PasswordFields Label="New Password"
                                    Password="@_newPassword"
                                    PasswordChanged="@(value => _newPassword = value)"
                                    ConfirmPassword="@_confirmPassword"
                                    ConfirmPasswordChanged="@(value => _confirmPassword = value)"
                                    OnChanged="@MarkDirty" />

                    @if (SameAsCurrent)
                    {
                        <p class="block text-sm text-red-600">New password must be different from the current password.</p>
                    }

                    <button type="submit" class="neba-btn neba-btn-primary w-full justify-center" disabled="@(!CanSubmit)">
                        @(_isSubmitting ? "Changing password…" : "Change password")
                    </button>
                    <a href="/" class="neba-btn neba-btn-secondary w-full justify-center">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@code {
    private enum ChangeOutcome { None, Changed, ChangedSessionNotSaved }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _email;
    private string? _errorMessage;
    private ChangeOutcome _outcome;
    private bool _isSubmitting;
    private bool _isDirty;

    private bool SameAsCurrent => _newPassword.Length > 0 && _newPassword == _currentPassword;

    private bool CanSubmit
        => !_isSubmitting
           && _currentPassword.Length > 0
           && _newPassword.Length > 0
           && _newPassword == _confirmPassword
           && !SameAsCurrent;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;
        _email = state.User.FindFirst(ClaimTypes.Email)?.Value;
    }

    private void MarkDirty() => _isDirty = true;

    private void HandleCurrentPasswordInput(ChangeEventArgs e)
    {
        _currentPassword = e.Value?.ToString() ?? string.Empty;
        MarkDirty();
    }

    private async Task HandleSubmitAsync()
    {
        if (!CanSubmit)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _outcome = ChangeOutcome.None;

        var result = await ApiExecutor.ExecuteAsync(
            "Security",
            "ChangePassword",
            ct => SecurityApi.ChangePasswordAsync(new ChangePasswordRequest
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword
            }, ct));

        if (result.IsError)
        {
            // 4xx text comes from the API (wrong current password, policy failure, lockout);
            // ApiExecutor already keeps 5xx generic.
            _errorMessage = result.FirstError.Description;
            _isSubmitting = false;
            return;
        }

        var response = result.Value;
        var tokens = new SessionTokens(response.UserId, response.Email, response.AccessToken, response.RefreshToken);

        // The API revoked the old refresh token, so this circuit must switch to the new pair now.
        // Same order as BearerTokenHandler after a silent refresh: cache first, under the refresh
        // lock, so later calls in this circuit use the new pair even if the cookie write fails.
        await TokenCache.RefreshLock.WaitAsync();
        try
        {
            TokenCache.Set(tokens);
        }
        finally
        {
            TokenCache.RefreshLock.Release();
        }

        var persisted = await SessionCookieSync.PersistAsync(tokens, CancellationToken.None);

        _currentPassword = string.Empty;
        _newPassword = string.Empty;
        _confirmPassword = string.Empty;
        _isDirty = false;
        _isSubmitting = false;
        _outcome = persisted ? ChangeOutcome.Changed : ChangeOutcome.ChangedSessionNotSaved;
    }
}
