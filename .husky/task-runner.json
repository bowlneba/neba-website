{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "dotnet-format-push",
      "group": "pre-push",
      "command": "sh",
      "args": [".husky/dotnet-format-push.sh"],
      "include": ["**/*.cs"]
    },
    {
      "name": "contract-mock-check",
      "group": "pre-push",
      "command": "sh",
      "args": [".husky/contract-mock-check.sh"],
      "include": ["src/Neba.Api.Contracts/**"]
    }
  ]
}