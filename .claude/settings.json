{
  "extraKnownMarketplaces": {
    "dotnet-agent-skills": {
      "source": {
        "source": "github",
        "repo": "dotnet/skills"
      }
    },
    "aspire-skills": {
      "source": {
        "source": "github",
        "repo": "microsoft/aspire-skills"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "dotnet-aspnetcore@dotnet-agent-skills": true,
    "dotnet-blazor@dotnet-agent-skills": true,
    "dotnet-data@dotnet-agent-skills": true,
    "dotnet-test@dotnet-agent-skills": true,
    "dotnet-upgrade@dotnet-agent-skills": true,
    "dotnet11@dotnet-agent-skills": true,
    "aspire@aspire-skills": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/block-secrets.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/check-architecture.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
